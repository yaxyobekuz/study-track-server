PORT=5000
MONGODB_URI=mongodb://localhost:27017/study-tracker
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=30d
NODE_ENV=development

# Default Owner credentials (will be created automatically)
DEFAULT_OWNER_USERNAME=admin
DEFAULT_OWNER_PASSWORD=admin123
DEFAULT_OWNER_FIRSTNAME=Administrator
DEFAULT_OWNER_LASTNAME=System

# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
MESSAGE_RATE_LIMIT_MS=1000

# Grade submission time limit (minutes after class ends)
GRADE_TIME_LIMIT_MINUTES=30

# Enable/disable schedule time validation for grading (true/false)
# If false, teachers can grade anytime regardless of lesson start/end times
ENABLE_SCHEDULE_TIME_VALIDATION=true

# Digital Ocean Space Bucket
DO_ENDPOINT=nyc3.digitaloceanspaces.com
DO_REGION=your-digitalocean-region
DO_ACCESS_KEY=your-digitalocean-access-key
DO_SECRET_KEY=your-digitalocean-secret-key
DO_BUCKET_NAME=your-digitalocean-bucket-name
DO_BUCKET_PUBLIC_BASE_URL=your-digitalocean-bucket-public-url

# Upload limits (In megabytes)
MAX_UPLOAD_FILE_SIZE_MB=20 