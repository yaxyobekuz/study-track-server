// ─────────────────────────────────────────────
// MOLIYA — TARIF VA CHEGIRMA BIRIKTIRISHLARI
// ─────────────────────────────────────────────
//
// ⚠️ KATALOGNING O'ZI BU YERDA EMAS. `Tariff`, `TariffVersion` va
// `Discount` — PLATFORMA schema'sida (prisma/platform/schema.prisma), chunki
// narx katalogi barcha filiallarga UMUMIY. Bu yerda faqat BIRIKTIRISH
// qatorlari qoladi: "shu o'quvchiga, shu oydan, shu tarif".
//
// Ko'chirish birorta bog'lanishni buzmadi, chunki `tariffId` va
// `discountId` allaqachon soft ref edi (FK YO'Q) — pastdagi izohlarga
// qarang. Narx esa hisob-fakturaga SNAPSHOT bo'lib muhrlanadi, ya'ni katalog
// qayerda turishidan qat'i nazar o'tgan fakt o'zgarmaydi.
//
// OY — `Int` YYYYMM (202608 = 2026-avgust), inklyuziv. Bu domenda kun
// darajasidagi koordinata umuman yo'q: "narx oshsa yangi oydan boshlab" talabi
// shundan kelib chiqadi. Taymzona butun domenda bitta joyda:
// helpers/month.helpers.js dagi currentMonthKey().
//
// PUL — Decimal(14,2) (Postgres NUMERIC). Float ISHLATILMAYDI. Service'da
// Prisma.Decimal (decimal.js) metodlari bilan hisoblanadi (`+` — string
// konkatenatsiya, jim xatolik!), API'ga har doim 2 xonali string sifatida
// chiqadi — helpers/money.helpers.js.

// O'quvchiga tarif biriktirish. NARX USTUNI YO'Q — bu kelajakka qaragan
// qoida, o'tgan fakt emas (MarketOrder.productSnapshot dan farqi shu).
// Narx har safar TariffVersion'dan hal qilinadi, shuning uchun tarif narxi
// oshganda birorta qatorga tegilmaydi.
model StudentTariff {
  // soft ref → User (role = "student"). FK YO'Q: moliyaviy tarix o'quvchi
  // o'chirilsa ham qolishi kerak (StudentAttendance.studentId uslubi).
  id         String   @id @db.Char(24)
  studentId  String   @map("student_id") @db.Char(24)
  // soft ref → Tariff. FK YO'Q — bu cross-entity bog'lanish, Tariff bu
  // qatorning egasi emas (MarketOrder.productId uslubi).
  tariffId   String   @map("tariff_id") @db.Char(24)
  startMonth Int      @map("start_month")
  // null → butun o'qish davri. startMonth === endMonth → faqat o'sha oy.
  endMonth   Int?     @map("end_month")
  note       String   @default("")
  createdBy  String   @map("created_by") @db.Char(24)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // `status` enum YO'Q — davrning o'zi holat. Biriktirish tugatilsa endMonth
  // qo'yiladi; xato kelajakdagi biriktirish o'chiriladi.
  @@unique([studentId, startMonth])
  @@index([studentId, startMonth(sort: Desc)])
  @@index([tariffId])
  @@map("student_tariffs")
}

// ─────────────────────────────────────────────
// O'QISH DAVRLARI
// ─────────────────────────────────────────────

// Nima uchun ketgani — erkin izoh emas, TOIFA: "bu yil nechta o'quvchi
// chetlatildi, nechtasi bitirdi" degan savolga hisobot javob bera olishi
// uchun. Yoniga `reason` matni ham yoziladi.
enum StudentEnrollmentEndReason {
  left // o'z ixtiyori bilan ketdi
  expelled // intizomiy chetlatish
  graduated // bitirdi
  transferred // boshqa filialga o'tdi
}

// O'QISH DAVRI — moliya domenidagi YAGONA kun aniqligidagi davr jadvali.
//
// NIMA UCHUN KUN, OY EMAS: kirish proratsiyasi aynan shu jadvalning mavjudlik
// sababi. Chiqishda kun hisobga olinmaydi (yuqoridagi doktrinaga qarang).
//
// QATOR YO'Q = ABADIY O'QIYDI. Bu orqaga moslik uchun: tizimga o'tishdan
// oldingi o'quvchilar hozirgidek to'liq oy to'lashda davom etadi.
// ⚠️ "Qator yo'q" degani o'quvchida BITTA HAM qator yo'q degani — shu oyni
// qamragan qator yo'q degani EMAS. Resolver davrlarni butun tarix bo'yicha
// o'qiydi va oy oralig'i bo'yicha FILTRLAMAYDI: aks holda o'tgan yili ketgan
// o'quvchi ham bo'sh ro'yxat berib, unga abadiy hisob-faktura yozilardi.
//
// ⚠️ KESISHUV: `tariffResolution.service.js` dagi "eng kech boshlangani
// yutadi" (`orderBy: startMonth desc`, birinchisini olish) naqshini bu
// jadvalga KO'CHIRMANG. Bir oyda bir nechta davr bo'lishi mumkin va
// HAMMASI muhim: ulardan BIRORTASI oyning 1-kunini qamrasa — to'liq oy,
// aks holda ENG ERTA kirish kuni olinadi.
//
// `endDate` INKLYUZIV — oxirgi o'qigan kun. Shu sababli [.., 09-30] va
// [10-01, ..] KESISHMAYDI: o'quvchi ertasiga qayta yozilishi mumkin.
model StudentEnrollment {
  id        String @id @db.Char(24)
  // soft ref → User (role = "student"), StudentTariff uslubi. FK YO'Q:
  // arxivlangan o'quvchining o'qish tarixi ham qolishi kerak.
  studentId String @map("student_id") @db.Char(24)

  // @db.Date — vaqt komponenti STRUKTURA BO'YICHA yo'q. Oy jadvallaridagi
  // `Int YYYYMM` bilan bir xil g'oya: taymzona ma'lumotdan chiqib ketadi.
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date // null = hozir o'qiyapti

  endReason StudentEnrollmentEndReason? @map("end_reason")
  reason    String                      @default("")
  note      String                      @default("")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Poyga backstop, kesishuv KAFOLATI EMAS: [09-01, 12-31] va [10-01, null]
  // ikkalasi ham o'tib ketadi — haqiqiy tekshiruv service'da, tranzaksiya ichida.
  @@unique([studentId, startDate])
  @@index([studentId, startDate(sort: Desc)])
  @@index([startDate, endDate])
  @@map("student_enrollments")
}

// ─────────────────────────────────────────────
// MOLIYA — CHEGIRMA BIRIKTIRISHLARI
// ─────────────────────────────────────────────
//
// Chegirma TURLARI katalogi (`Discount`) — platforma schema'sida, barcha
// filiallarga umumiy. Bu yerda faqat "kimga, qachondan" qatorlari.

// DIQQAT — StudentTariff bilan SHAKLI bir xil, MA'NOSI TESKARI:
// tarifda kesishuv HAL QILINADI (eng kech boshlangani yutadi,
// tariffResolution.service.js:68), chegirmada esa kesishuv QO'SHILADI.
// Shuning uchun bu yerda service darajasidagi kesishuv tekshiruvi
// MAJBURIY — tarif kodidagi "orderBy desc, birinchisi yutadi" naqshini
// bu jadvalga KO'CHIRMANG.
model StudentDiscount {
  id         String   @id @db.Char(24)
  // soft ref → User (role = "student"), StudentTariff uslubi
  studentId  String   @map("student_id") @db.Char(24)
  // soft ref → Discount — katalog bu qatorning egasi emas
  discountId String   @map("discount_id") @db.Char(24)
  startMonth Int      @map("start_month")
  // null → ochiq davr. startMonth === endMonth → faqat o'sha oy.
  endMonth   Int?     @map("end_month")
  note       String   @default("")
  createdBy  String   @map("created_by") @db.Char(24)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Poyga backstop, kesishuv KAFOLATI EMAS: [202609,202612] va [202610,null]
  // ikkalasi ham o'tib ketadi — haqiqiy tekshiruv service'da.
  @@unique([studentId, discountId, startMonth])
  @@index([studentId, startMonth(sort: Desc)])
  // Cron: "shu oyni qamragan barcha qatorlar" — butun maktab bo'yicha bitta so'rov
  @@index([startMonth, endMonth])
  @@index([discountId])
  @@map("student_discounts")
}

// ─────────────────────────────────────────────
// MOLIYA — HOLAT VA HISOB-FAKTURALAR
// ─────────────────────────────────────────────
//
// O'QUV YILI TUSHUNCHASI YO'Q. O'qish davri cheksiz deb qaraladi: o'quvchi
// maktabda bo'lgan HAR OY uchun to'lov yoziladi. Yagona umumiy istisno —
// VacationMonth ("iyulda o'qimaymiz"), yagona shaxsiy istisno — frozen.
// Shu sababli hisob-fakturada "9 oydan 3-si" kabi yorliq ham YO'Q: cheksiz
// davrda "nechanchi oy" degan raqamning maxraji bo'lmaydi.
//
// KUN KOORDINATASI bu domenda uch joyda bor, boshqa hech qayerda emas:
//   1) FinanceSettings.invoiceDayOfMonth — cron qachon ishlashi (konfiguratsiya),
//   2) Payment.paidAt / AccountEntry.occurredAt — pul qachon harakatlandi
//      (hodisa, davr emas),
//   3) StudentEnrollment.startDate — o'quvchi maktabga kelgan kun, va uning
//      hisob-fakturaga muhrlangan izi (billableDays / monthDays).
//
// KIRISHDA kun bor, CHIQISHDA yo'q. Oy o'rtasida KELGAN o'quvchi o'sha oyni
// ulushga to'laydi (20-kunda keldi → 12/31). Oy o'rtasida KETGAN o'quvchi esa
// o'sha oyni TO'LIQ to'laydi — "oyda 1 kun o'qisa ham to'liq oy" qoidasi
// kuchda qoladi va `endDate` faqat hisob-faktura BOR-YO'QLIGINI hal qiladi,
// SUMMASINI emas.
//
// Taymzona ma'lumotdan `@db.Date` bilan chiqarib tashlangan: sana ustunida
// vaqt komponenti saqlanmaydi. Kun qiymatlari FAQAT `getUTC*` bilan o'qiladi
// (helpers/month.helpers.js) va faqat `parseDayDate` orqali kiritiladi.

model FinanceSettings {
  id String @id @default("singleton") @db.VarChar(24)

  // Oyning nechanchi kunida majburiyat shakllanadi. 1..28 bilan cheklanadi —
  // 29-31 fevralda hech qachon kelmaydi. Cron IFODASIDA emas, HANDLER'da
  // o'qiladi: sozlama bazada, cron ifodasi esa startup'da qotib qoladi.
  invoiceDayOfMonth Int @default(1) @map("invoice_day_of_month")

  // Avtomatik shakllantirishni butunlay o'chirish (migratsiya/sinov davri)
  autoGenerateEnabled Boolean @default(true) @map("auto_generate_enabled")

  // Har passda necha oy ORQAGA qayta urinilsin. Server oy chegarasidan oshib
  // o'chib qolgan bo'lsa, yo'qolgan oy shu bilan tiklanadi. 0 = backfill yo'q.
  catchUpMonths Int @default(1) @map("catch_up_months")

  // Qattiq pol: bu oydan oldin hech qachon hisob-faktura shakllanmaydi —
  // tizimga o'tishdan oldingi oylarga qarz yozib qo'yishning oldini oladi.
  firstInvoiceMonth Int? @map("first_invoice_month")

  // Yangi hisob-faktura chiqqanda o'quvchining oldindan to'langan qoldig'i
  // avtomatik yechilsinmi. O'chirilsa — depozit qo'lda qo'llanadi.
  depositAutoApply Boolean @default(true) @map("deposit_auto_apply")

  // Kirish proratsiyasi yoqilganmi (autoGenerateEnabled uslubidagi kill switch).
  prorationEnabled Boolean @default(true) @map("proration_enabled")
  // Proratsiya natijasi shu birlikka PASTGA yaxlitlanadi — ATAYLAB maktab
  // zarariga (367 712 → 367 000). 0 yoki 1 = yaxlitlash yo'q. Faqat tarif
  // narxi birlikdan katta bo'lganda qo'llanadi, aks holda kichik tarif
  // nolga tushib "to'langan" bo'lib qolardi.
  roundingUnit     Int     @default(1000) @map("rounding_unit")

  // Cron watermark'i — FAQAT UI uchun. To'g'rilik bunga tayanmaydi:
  // idempotentlik @@unique([studentId, month]) da.
  lastRunAt          DateTime? @map("last_run_at")
  lastGeneratedMonth Int?      @map("last_generated_month")

  updatedBy String?  @map("updated_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("finance_settings")
}

// MOLIYAVIY REJA (byudjet) — rahbar dashboardidagi "Reja:" qatorlari.
//
// NIMA UCHUN ALOHIDA JADVAL: dashboarddagi HAR BIR raqamning AMALDAGI
// qiymati tizimdan hisoblanadi (to'lov, xarajat, baho, davomat), lekin
// "shuncha bo'lishi kerak edi" degan raqam hech qayerdan chiqmaydi — u
// rahbarning QARORI. Uni sozlamalar singletoniga tiqib bo'lmaydi, chunki
// reja HAR OY boshqacha.
//
// ⚠️ `actualValue` — ISTISNO, sukut bo'yicha null. U faqat tizimda MANBASI
// YO'Q ko'rsatkich uchun ishlatiladi (hozircha bittasi: NPS — ota-onalar
// so'rovi tizimda yuritilmaydi). Manbasi bor ko'rsatkichga qo'lda "amalda"
// yozib qo'yish — hisobotni yolg'onlashtirishning eng oson yo'li, shuning
// uchun service uni faqat `manualActual` metrikalarida qabul qiladi
// (`helpers/financeMetrics.js`).
//
// Pul va foiz BITTA ustunda: ikkalasi ham Decimal(14,2) ga sig'adi va
// metrika kaliti qaysi biri ekanini bir ma'noda aytadi.
model FinanceTarget {
  id String @id @db.Char(24)

  month  Int // YYYYMM
  metric String @db.VarChar(40) // financeMetrics.js dagi kalit

  planValue   Decimal  @map("plan_value") @db.Decimal(14, 2)
  actualValue Decimal? @map("actual_value") @db.Decimal(14, 2)

  note String @default("")

  createdBy String   @map("created_by") @db.Char(24)
  updatedBy String?  @map("updated_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([month, metric])
  @@index([month])
  @@map("finance_targets")
}

// Ta'til oyi — MAKTAB BO'YICHA. O'sha oyda hech kimga hisob-faktura
// shakllanmaydi (o'quvchi bo'yicha to'xtatish — StudentFinanceStatus.frozen).
//
// TO'LOVDAN OZOD OY. O'quv yili tushunchasi YO'Q: sukut bo'yicha HAR OY
// to'lanadi, ta'til esa yagona umumiy istisno — "iyulda o'qimaymiz, to'lov
// ham yo'q". Butun maktabga tegishli; bitta o'quvchini vaqtincha to'xtatish
// uchun StudentFinanceStatus.frozen ishlatiladi.
model VacationMonth {
  id    String @id @db.Char(24)
  month Int    @unique // YYYYMM

  title     String   @default("") // "Qishki ta'til"
  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("vacation_months")
}

// O'quvchining moliyaviy holati — DAVR jadvali, StudentTariff bilan bir xil
// shakl. QATOR YO'Q = FAOL: faqat istisnolar (muzlatish/chetlatish) yoziladi,
// shuning uchun jadval kichik qoladi va cron'ning istisno so'rovi arzon.
model StudentFinanceStatus {
  id        String @id @db.Char(24)
  // soft ref → User (role = "student"). FK YO'Q — moliyaviy tarix o'quvchi
  // arxivlansa/o'chirilsa ham qolishi kerak (StudentTariff uslubi).
  studentId String @map("student_id") @db.Char(24)

  status     StudentFinanceStatusEnum
  startMonth Int                      @map("start_month")
  // null → ochiq davr. startMonth === endMonth → faqat o'sha oy.
  endMonth   Int?                     @map("end_month")

  // "Nima uchun muzlatildi" — auditning yagona matnli manbasi
  reason String @default("")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Kesishuv tekshiruvi service'da; poyga holatidagi HAQIQIY kafolat — shu.
  @@unique([studentId, startMonth])
  @@index([studentId, startMonth(sort: Desc)])
  // Cron: "shu oyni qamragan barcha qatorlar" — butun maktab bo'yicha bitta so'rov
  @@index([startMonth, endMonth])
  @@map("student_finance_statuses")
}

// Oylik to'lov majburiyati. Bu YOZILGAN FAKT — StudentTariff'dan tubdan farq
// qiladi: biriktirish kelajakka qaragan qoida (narx saqlamaydi), hisob-faktura
// esa o'tgan fakt, shuning uchun SNAPSHOT aynan shu yerda olinadi
// (MarketOrder.productSnapshot uslubi).
//
// QAYTARILMASLIK: `amount` ni o'zgartiradigan endpoint YO'Q. Narx keyin
// to'g'rilansa bu qatorga tegilmaydi — tuzatish keyingi oydan amal qiladi.
// Yagona "o'chirish" — `cancelled` holati, sababi va aktyori bilan.
model MonthlyInvoice {
  id String @id @db.Char(24)

  // soft ref → User. FK YO'Q: arxivlangan/o'chirilgan o'quvchining qarzi
  // hisobotda qolishi SHART.
  studentId String @map("student_id") @db.Char(24)
  month     Int // YYYYMM, inklyuziv

  // Narx provenansiyasi. Nullable: qo'lda yaratilgan hisob-fakturada tarif
  // bo'lmasligi mumkin.
  tariffId        String? @map("tariff_id") @db.Char(24)
  tariffVersionId String? @map("tariff_version_id") @db.Char(24)
  // Nomi ALOHIDA saqlanadi: tarif qayta nomlansa ham o'tgan hisob-faktura
  // yorlig'i o'zgarmaydi.
  tariffName      String  @default("") @map("tariff_name")

  // Chegirmagacha VA proratsiyagacha bo'lgan to'liq tarif narxi — "qancha
  // chegirma/proratsiya berdik?" savoliga javob berish uchun saqlanadi.
  baseAmount Decimal @map("base_amount") @db.Decimal(14, 2)

  // KIRISH PRORATSIYASI koordinatasi — snapshot. null = proratsiya yo'q
  // (to'liq oy), shu jumladan bu maydonlardan oldin chiqarilgan qatorlar.
  billableDays Int? @map("billable_days")
  monthDays    Int? @map("month_days")
  roundingUnit Int? @map("rounding_unit") // amaldagi sozlama snapshot'i

  // floor(baseAmount × billableDays / monthDays, roundingUnit).
  // Proratsiya bo'lmasa = baseAmount. CHEGIRMA AYNAN SHUNGA qo'llanadi —
  // to'liq narxga emas. Aks holda `discountSnapshot` dagi ulushlar yig'indisi
  // `discountAmount` ga teng bo'lmay qolardi (discount.helpers.js).
  proratedAmount Decimal @map("prorated_amount") @db.Decimal(14, 2)

  discountAmount   Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  // [{ discountId, name, type, value, nominalAmount, appliedAmount }] —
  // chiqarilgan paytdagi chegirmalar. `appliedAmount`lar yig'indisi AYNAN
  // discountAmount ga teng (oxirgisiga qoldiq beriladi), lekin ustunlar
  // orasidagi hakam — discountAmount, snapshot esa taqsimot izohi.
  discountSnapshot Json?   @map("discount_snapshot")

  // MUHRLANGAN summa = proratedAmount − discountAmount.
  // (Proratsiyagacha bu `baseAmount − discountAmount` edi.)
  // Hech qachon qayta hisoblanmaydi; keyingi to'g'rilash keyingi oydan
  // amal qiladi. Invariantni financeReconcile job har kecha tekshiradi.
  amount     Decimal @db.Decimal(14, 2)
  // To'lovlar yig'indisi (denormalizatsiya): ro'yxatni qarz bo'yicha
  // saralash/filtrlash har qator uchun agregatsiyasiz ishlashi kerak.
  // Faqat tranzaksiya ichida increment/decrement bilan yangilanadi.
  paidAmount Decimal @default(0) @map("paid_amount") @db.Decimal(14, 2)

  status InvoiceStatus @default(unpaid)
  source InvoiceSource @default(cron)

  // { firstName, lastName, username, classId, className } — chiqarilgan
  // paytdagi holat. O'quvchi qatori umuman bo'lmasa ham hisobot ko'rsatiladi.
  studentSnapshot Json @map("student_snapshot")

  note String @default("")

  cancelReason String    @default("") @map("cancel_reason")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by") @db.Char(24)

  // Kech qo'shilgan chegirma / to'g'rilangan tarif: summa muhrlangani uchun
  // yagona halol yo'l — bekor qilib qaytadan yaratish. Eskisi bilan bog'lanish.
  replacesInvoiceId String? @map("replaces_invoice_id") @db.Char(24)

  // To'liq yopilgan payt
  paidAt DateTime? @map("paid_at")

  // null = tizim (cron); qiymat bo'lsa — qo'lda shakllantirgan admin
  createdBy String?  @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  allocations PaymentAllocation[]

  // IDEMPOTENTLIK: cron qayta ishga tushishi, ikkita instans, admin'ning qo'lda
  // urinishi — hammasi shu bilan xavfsiz.
  @@unique([studentId, month])
  // "2026-09, to'lanmaganlar" — asosiy admin ekrani
  @@index([month, status])
  // O'quvchi kartasi va student self endpoint
  @@index([studentId, month(sort: Desc)])
  // "Barcha qarzdorlar" (oylar bo'ylab)
  @@index([status, month])
  // dueDate YO'Q: "muddati o'tgan" = month < currentMonthKey() && status != paid.
  @@map("monthly_invoices")
}

// ─────────────────────────────────────────────
// MOLIYA — KASSA (to'lov hisoblari va daftari)
// ─────────────────────────────────────────────

// Pul qayerga tushadi: "Naqd kassa", "Uzcard terminal", "Ipoteka bank".
// Dinamik katalog — `PaymentMethod` enumining o'rnini bosadi.
model PaymentAccount {
  id   String @id @db.Char(24)
  name String @unique

  // Tizimga o'tishdagi boshlang'ich qoldiq. balance = openingBalance + Σ entries
  // (har kecha financeReconcile job tekshiradi).
  openingBalance Decimal @default(0) @map("opening_balance") @db.Decimal(14, 2)
  balance        Decimal @default(0) @db.Decimal(14, 2)

  isActive   Boolean @default(true) @map("is_active")
  // Hisob HECH QACHON o'chirilmaydi — arxivlanadi. Shu sababli unga
  // ko'rsatgan FK'lar Restrict.
  isArchived Boolean @default(false) @map("is_archived")
  sortOrder  Int     @default(0) @map("sort_order")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entries         AccountEntry[]
  payments        Payment[]
  refunds         Refund[]
  transfersFrom   AccountTransfer[] @relation("TransferFrom")
  transfersTo     AccountTransfer[] @relation("TransferTo")
  externalIncomes ExternalIncome[]
  salaryPayments  SalaryPayment[]
  expenses        Expense[]
  damagePayments  DamagePayment[]

  @@index([isArchived, isActive, sortOrder])
  @@map("payment_accounts")
}

// TASHQI KIRIM KATEGORIYASI — "Ijara", "Kitob sotuvi", "Homiylik".
//
// FILIALDA yashaydi (platformada emas): har filialning o'z daromad manbalari
// bor va daftar ham filialda — platformaga chiqarilsa FK'ni ifodalab
// bo'lmasdi. Tarif/chegirma katalogidan farqi shunda.
model IncomeCategory {
  id   String @id @db.Char(24)
  name String @unique

  isActive   Boolean @default(true) @map("is_active")
  // Kategoriya HECH QACHON o'chirilmaydi — arxivlanadi. O'tgan kirimlar
  // unga ishora qiladi, shuning uchun FK Restrict.
  isArchived Boolean @default(false) @map("is_archived")
  sortOrder  Int     @default(0) @map("sort_order")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  incomes ExternalIncome[]

  @@index([isArchived, isActive, sortOrder])
  @@map("income_categories")
}

// TASHQI KIRIM — o'quvchi to'lovi bo'lmagan pul: ijara, kitob sotuvi,
// homiylik. HUJJAT + uning daftardagi izi (Payment / AccountTransfer bilan
// bir xil munosabat).
//
// ⚠️ Bu KIRIM. Chiqim (xarajat, ish haqi) hali yo'q — keyingi bosqich.
model ExternalIncome {
  id String @id @db.Char(24)

  categoryId String @map("category_id") @db.Char(24)
  accountId  String @map("account_id") @db.Char(24)

  amount Decimal @db.Decimal(14, 2) // musbat

  // Kategoriya nomi MUHRLANADI (MonthlyInvoice.tariffName doktrinasi):
  // kategoriya keyin qayta nomlansa, o'tgan hisobot o'zgarmasligi kerak.
  categoryName String @default("") @map("category_name")

  payer String @default("") // "Anvar aka", "Korzinka MCHJ"
  note  String @default("")

  occurredAt DateTime @map("occurred_at") // pul QACHON kirdi

  // Bekor qilish — bayroq + daftardagi TESKARI qator. Bayroqning o'zi
  // yetarli emas: kassa qoldig'i faqat kompensatsiya qatori bilan qaytadi.
  isVoided   Boolean   @default(false) @map("is_voided")
  voidedAt   DateTime? @map("voided_at")
  voidedBy   String?   @map("voided_by") @db.Char(24)
  voidReason String    @default("") @map("void_reason")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category IncomeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account  PaymentAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  entries  AccountEntry[]

  @@index([occurredAt(sort: Desc)])
  @@index([categoryId, occurredAt(sort: Desc)])
  @@index([accountId, occurredAt(sort: Desc)])
  @@map("external_incomes")
}

// ─────────────────────────────────────────────
// CHIQIM — xodimlar oyligi va xarajatlar
// ─────────────────────────────────────────────
//
// ⚠️ LOCK TARTIBI (kirim tomonidagi qoidaning davomi):
//
//   KIRIM :  StudentAccount → MonthlyInvoice (month asc, id asc) → PaymentAccount
//   CHIQIM:                   PayrollEntry   (month asc, id asc) → PaymentAccount
//
// `PaymentAccount` HAR IKKALA yo'lda ham OXIRGI. O'quvchi to'lovi va xodim
// oyligi bir vaqtda kelganda deadlock shu sababli bo'lmaydi. Kassa avval
// lock qilinsa, ikki jarayon bir-birini kutib qolardi.

// OYLIK QOIDASI — `StudentTariff` bilan bir xil shakl: davr bilan biriktirish.
//
// ⚠️ Tarifdan FARQI: summa shu yerda SAQLANADI. Tarif — katalog (ko'p
// o'quvchiga bitta narx), xodim oyligi esa har kimda o'ziniki.
model StaffSalary {
  id      String @id @db.Char(24)
  // soft ref → User (role != student). FK YO'Q: xodim arxivlansa ham
  // moliyaviy tarix qolishi kerak (StudentTariff uslubi).
  staffId String @map("staff_id") @db.Char(24)

  type   SalaryType @default(fixed)
  amount Decimal    @db.Decimal(14, 2)

  startMonth Int  @map("start_month")
  endMonth   Int? @map("end_month")

  note String @default("")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Poyga backstop'i — kesishuv KAFOLATI EMAS, uni service tekshiradi
  @@unique([staffId, startMonth])
  @@index([staffId, startMonth(sort: Desc)])
  @@map("staff_salaries")
}

// OYLIK MAJBURIYAT — `MonthlyInvoice` ning ko'zgusi.
//
// ⚠️ `amount` MUHRLANADI: uni o'zgartiradigan endpoint YO'Q. Xato bo'lsa
// bekor qilinib qayta shakllantiriladi (hisob-faktura doktrinasi).
//
// ⚠️ Kun proratsiyasi YO'Q. "Fiksa" — qat'iy summa, oy aniqligida. Oy
// o'rtasida ishga kirgan xodim uchun `startMonth` keyingi oydan qo'yiladi.
model PayrollEntry {
  id      String @id @db.Char(24)
  staffId String @map("staff_id") @db.Char(24)
  month   Int // YYYYMM

  amount     Decimal @db.Decimal(14, 2)
  paidAmount Decimal @default(0) @map("paid_amount") @db.Decimal(14, 2)

  status     PayrollStatus @default(unpaid)
  salaryType SalaryType    @default(fixed) @map("salary_type")

  // Xodim arxivlansa/o'chirilsa ham registr o'qilishi kerak
  staffSnapshot Json @map("staff_snapshot")

  note String @default("")

  cancelReason String    @default("") @map("cancel_reason")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by") @db.Char(24)

  paidAt DateTime? @map("paid_at")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  allocations SalaryAllocation[]

  @@unique([staffId, month])
  @@index([month, status])
  @@index([staffId, month(sort: Desc)])
  @@map("payroll_entries")
}

// OYLIK TO'LOVI — `Payment` ning ko'zgusi, LEKIN DEPOZITSIZ.
//
// ⚠️ Xodimda "hamyon" yo'q: qarzdan ortiq to'lov RAD ETILADI. Avans
// tushunchasi qo'shilmagani uchun ortiqcha pulni saqlaydigan joy ham
// kerak emas. Bitta oylikni bir necha marta to'lash esa MUMKIN.
model SalaryPayment {
  id        String @id @db.Char(24)
  staffId   String @map("staff_id") @db.Char(24)
  accountId String @map("account_id") @db.Char(24)

  amount Decimal @db.Decimal(14, 2) // musbat; daftarga MANFIY tushadi

  paidAt DateTime @map("paid_at")
  note   String   @default("")

  staffSnapshot Json @map("staff_snapshot")

  isVoided   Boolean   @default(false) @map("is_voided")
  voidedAt   DateTime? @map("voided_at")
  voidedBy   String?   @map("voided_by") @db.Char(24)
  voidReason String    @default("") @map("void_reason")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account     PaymentAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  allocations SalaryAllocation[]
  entries     AccountEntry[]

  @@index([staffId, paidAt(sort: Desc)])
  @@index([accountId, paidAt(sort: Desc)])
  @@index([paidAt])
  @@map("salary_payments")
}

// To'lov qaysi oylikni yopdi — `PaymentAllocation` ning ko'zgusi.
model SalaryAllocation {
  id             String @id @db.Char(24)
  paymentId      String @map("payment_id") @db.Char(24)
  payrollEntryId String @map("payroll_entry_id") @db.Char(24)
  staffId        String @map("staff_id") @db.Char(24)

  amount Decimal @db.Decimal(14, 2)

  appliedAt DateTime @map("applied_at")

  isVoided  Boolean   @default(false) @map("is_voided")
  voidedAt  DateTime? @map("voided_at")
  createdAt DateTime  @default(now()) @map("created_at")

  payment      SalaryPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  payrollEntry PayrollEntry  @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)

  @@index([payrollEntryId, isVoided])
  @@index([paymentId])
  @@map("salary_allocations")
}

// XARAJAT KATEGORIYASI — `IncomeCategory` ning aynan ko'zgusi.
model ExpenseCategory {
  id   String @id @db.Char(24)
  name String @unique

  // EBITDA = sof foyda + SHU bayroqli kategoriyalardagi xarajatlar.
  // Foiz, soliq va amortizatsiya alohida jadvalda yuritilmaydi — ular ham
  // oddiy xarajat qatori. Shuning uchun "EBITDA dan chiqarib tashlanadi"
  // qarori KATEGORIYA darajasida beriladi: buxgalter "Soliqlar" va
  // "Amortizatsiya" ni belgilaydi, qolgan hamma narsa operatsion xarajat.
  // Sukut bo'yicha false — hech nima belgilanmagunicha EBITDA sof foydaga teng.
  excludeFromEbitda Boolean @default(false) @map("exclude_from_ebitda")

  isActive   Boolean @default(true) @map("is_active")
  // O'CHIRILMAYDI — arxivlanadi. O'tgan xarajatlar unga ishora qiladi.
  isArchived Boolean @default(false) @map("is_archived")
  sortOrder  Int     @default(0) @map("sort_order")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@index([isArchived, isActive, sortOrder])
  @@map("expense_categories")
}

// XARAJAT — `ExternalIncome` ning ko'zgusi, faqat pul CHIQADI.
// Kommunal, ta'mirlash, jihoz, oziq-ovqat. Oylik BU YERDA EMAS —
// u alohida mexanizm (PayrollEntry + SalaryPayment).
model Expense {
  id String @id @db.Char(24)

  categoryId String @map("category_id") @db.Char(24)
  accountId  String @map("account_id") @db.Char(24)

  amount Decimal @db.Decimal(14, 2) // musbat; daftarga MANFIY tushadi

  // Kategoriya nomi MUHRLANADI — keyin qayta nomlansa hisobot o'zgarmaydi
  categoryName String @default("") @map("category_name")

  payee String @default("") // kimga to'landi
  note  String @default("")

  occurredAt DateTime @map("occurred_at")

  isVoided   Boolean   @default(false) @map("is_voided")
  voidedAt   DateTime? @map("voided_at")
  voidedBy   String?   @map("voided_by") @db.Char(24)
  voidReason String    @default("") @map("void_reason")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account  PaymentAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  entries  AccountEntry[]

  @@index([occurredAt(sort: Desc)])
  @@index([categoryId, occurredAt(sort: Desc)])
  @@index([accountId, occurredAt(sort: Desc)])
  @@map("expenses")
}

// Hisoblar orasidagi o'tkazma — HUJJAT; postinglari ikkita AccountEntry
// (Payment → PaymentAllocation bilan bir xil munosabat).
//
// DEADLOCK: transfer(A→B) va transfer(B→A) parallel kelganda hisoblar
// HAR DOIM `id` bo'yicha O'SISH tartibida lock qilinadi, yo'nalishdan
// qat'i nazar — accountTransfer.service.js.
model AccountTransfer {
  id            String @id @db.Char(24)
  fromAccountId String @map("from_account_id") @db.Char(24)
  toAccountId   String @map("to_account_id") @db.Char(24)

  amount Decimal @db.Decimal(14, 2) // musbat
  // Click → bank o'tkazmasi komissiyasi. Ikki simmetrik posting bilan
  // buni ifodalab bo'lmaydi — shuning uchun hujjat modeli kerak.
  fee    Decimal @default(0) @db.Decimal(14, 2)

  occurredAt DateTime @map("occurred_at")
  note       String   @default("")

  isVoided   Boolean   @default(false) @map("is_voided")
  voidedAt   DateTime? @map("voided_at")
  voidedBy   String?   @map("voided_by") @db.Char(24)
  voidReason String    @default("") @map("void_reason")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")

  fromAccount PaymentAccount @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   PaymentAccount @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  entries     AccountEntry[]

  @@index([occurredAt(sort: Desc)])
  @@map("account_transfers")
}

// Kassa daftari — QAT'IY APPEND-ONLY. Xato yozuv o'chirilmaydi ham,
// tahrirlanmaydi ham: teskari (kompensatsiya) qatori yoziladi.
model AccountEntry {
  id String @id @db.Char(24)

  // QO'SHILISH tartibi. balanceAfter AYNAN shunga bog'liq: kassir kechagi
  // sana bilan to'lov kiritsa, qator `occurredAt` bo'yicha ro'yxatning
  // O'RTASIGA tushadi va running balance ustuni ma'nosiz bo'lib qolardi.
  // Registr `seq` bo'yicha, hisobot `occurredAt` bo'yicha.
  seq BigInt @default(autoincrement())

  accountId    String           @map("account_id") @db.Char(24)
  type         AccountEntryType
  // ISHORALI: + kirim, − chiqim. SUM() hisobotlarni ahamiyatsiz qiladi.
  // Ishora tipga mos kelishi assertSignMatchesType bilan tekshiriladi.
  amount       Decimal          @db.Decimal(14, 2)
  // "seq raqamli yozuvdan keyingi qoldiq" — nazoratchi ustunni pastga
  // qarab o'qiy oladi. Qiymat `paymentAccount.update({increment})` dan
  // QAYTGAN post-image'dan olinadi (o'qi→hisobla→yoz EMAS).
  balanceAfter Decimal          @map("balance_after") @db.Decimal(14, 2)

  // BIZNES sanasi (to'lovda = payment.paidAt) — hisobot filtri shunga tayanadi
  occurredAt DateTime @map("occurred_at")

  paymentId        String? @map("payment_id") @db.Char(24)
  transferId       String? @map("transfer_id") @db.Char(24)
  refundId         String? @map("refund_id") @db.Char(24)
  externalIncomeId String? @map("external_income_id") @db.Char(24)
  salaryPaymentId  String? @map("salary_payment_id") @db.Char(24)
  expenseId        String? @map("expense_id") @db.Char(24)
  damagePaymentId  String? @map("damage_payment_id") @db.Char(24)

  note      String   @default("")
  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")

  // Restrict, Cascade EMAS: Cascade pul logini hisob bilan birga
  // olib ketardi. AccountEntry — hisobning egalik ostidagi bolasi
  // (TariffVersion→Tariff uslubi), shuning uchun soft ref emas, haqiqiy FK.
  account        PaymentAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  payment        Payment?         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  transfer       AccountTransfer? @relation(fields: [transferId], references: [id], onDelete: Restrict)
  externalIncome ExternalIncome?  @relation(fields: [externalIncomeId], references: [id], onDelete: Restrict)
  salaryPayment  SalaryPayment?   @relation(fields: [salaryPaymentId], references: [id], onDelete: Restrict)
  expense        Expense?         @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  damagePayment  DamagePayment?   @relation(fields: [damagePaymentId], references: [id], onDelete: Restrict)

  @@index([accountId, seq(sort: Desc)]) // registr + running balance
  @@index([accountId, occurredAt]) // "X–Y oralig'idagi kirim"
  @@index([occurredAt])
  @@index([transferId])
  @@index([externalIncomeId])
  @@index([salaryPaymentId])
  @@index([expenseId])
  @@index([damagePaymentId])
  @@map("account_entries")
}

// ─────────────────────────────────────────────
// MOLIYA — TO'LOV VA DEPOZIT
// ─────────────────────────────────────────────
//
// DEPOZIT ALOHIDA "HAMYON" EMAS. U — aniq Payment qatorlarining
// taqsimlanmagan qoldig'i. Agar depozit alohida pot bo'lganida, pul
// hisob-fakturaga IKKI xil yo'l bilan tushardi (kassir taqsimoti va
// "depozitdan yechish" qadami) va quyidagi holat hal qilib bo'lmas bo'lardi:
//
//   1-okt: 1 000 000 to'landi → sentabr (400k) yopildi, 600k depozit
//   1-noy: noyabr depozitdan yopildi → qoldiq 200k
//   5-noy: to'lov xato ekan, bekor qilinadi — 1 000 000 qaytarilishi kerak,
//          lekin depozitda 200k bor
//
// Noyabrni yopish ham SHU to'lovning taqsimoti (source: deposit) bo'lgani
// uchun bekor qilish qoidasi bitta: shu to'lovning barcha taqsimotlarini
// qaytar. Noyabr qayta ochiladi, qoldiqdan faqat ushlanib turgan 200k
// yechiladi, jami olib tashlangan = 1 000 000. Manfiy balans TUG'ILMAYDI.

// Kassa cheki — pulni bir marta qabul qilish akti.
model Payment {
  id String @id @db.Char(24)

  // Ota-onaga aytiladigan RAQAM. Hozir qo'shiladi: 3000 ta to'lovdan keyin
  // retro-raqamlash imkonsiz. Bekor qilingan tranzaksiyalardan bo'shliq
  // qolishi mumkin — chekni YO'QOTISHdan ko'ra yaxshiroq.
  receiptNo Int @unique @default(autoincrement()) @map("receipt_no")

  // soft ref → User: arxivlangan o'quvchining cheki qolishi SHART
  studentId String @map("student_id") @db.Char(24)
  // FK: hisob o'chirilmaydi (arxivlanadi), dangling pointer qoldiqni buzardi
  accountId String @map("account_id") @db.Char(24)

  amount          Decimal @db.Decimal(14, 2)
  // HOSILA, tezlik uchun denormalizatsiya:
  //   allocatedAmount = Σ (isVoided = false) allocations
  //   depositAmount   = amount − allocatedAmount
  // Ikkalasi ham lock ostida qayta hisoblanadi.
  allocatedAmount Decimal @default(0) @map("allocated_amount") @db.Decimal(14, 2)
  depositAmount   Decimal @default(0) @map("deposit_amount") @db.Decimal(14, 2)

  // Pul qachon olindi. Orqaga sanash qonuniy: kassir kechagi to'lovni
  // bugun kiritishi mumkin.
  paidAt          DateTime @map("paid_at")
  note            String   @default("")
  // { firstName, lastName, username, classId, className } — hisobot
  // o'quvchi qatori bo'lmasa ham ishlashi uchun
  studentSnapshot Json     @map("student_snapshot")

  // QISMAN BEKOR QILISH YO'Q: xato summa → to'liq bekor + qayta kiritish.
  // Qisman bekor qilish bu tizimlarni auditsiz qiladigan asosiy yo'l.
  isVoided   Boolean   @default(false) @map("is_voided")
  voidedAt   DateTime? @map("voided_at")
  voidedBy   String?   @map("voided_by") @db.Char(24)
  voidReason String    @default("") @map("void_reason")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account     PaymentAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]
  entries     AccountEntry[]

  @@index([studentId, paidAt(sort: Desc)])
  @@index([accountId, paidAt(sort: Desc)])
  @@index([paidAt])
  @@map("payments")
}

// Chekning bitta hisob-fakturaga tushgan ulushi.
model PaymentAllocation {
  id        String @id @db.Char(24)
  paymentId String @map("payment_id") @db.Char(24)
  invoiceId String @map("invoice_id") @db.Char(24)
  // Denormalizatsiya: o'quvchining balans harakatlari uchun
  studentId String @map("student_id") @db.Char(24)

  amount    Decimal          @db.Decimal(14, 2)
  source    AllocationSource @default(payment)
  // To'lov sanasidan FARQ QILADI: `deposit` manbali qator keyingi oy
  // yaratiladi. Balans harakatlari tarixi shu bo'yicha tuziladi.
  appliedAt DateTime         @map("applied_at")

  isVoided  Boolean   @default(false) @map("is_voided")
  voidedAt  DateTime? @map("voided_at")
  createdAt DateTime  @default(now()) @map("created_at")

  payment Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice MonthlyInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, isVoided])
  @@index([paymentId, isVoided])
  @@index([studentId, appliedAt(sort: Desc)])
  @@map("payment_allocations")
}

// O'quvchining oldindan to'langan qoldig'i.
//
// `version` — LOCK USTUNI. O'quvchining puliga tegadigan HAR QANDAY
// tranzaksiyaning BIRINCHI operatori shu qatorni increment qiladi va
// commit'gacha eksklyuziv row-lock ushlaydi. Butun modul bo'yicha
// o'zgarmas LOCK TARTIBI:
//     StudentAccount → MonthlyInvoice (month asc, id asc) → PaymentAccount
// O'quvchilar bir-biri bilan to'qnashmagani uchun deadlock imkonsiz.
model StudentAccount {
  id        String @id @db.Char(24)
  // soft ref → User
  studentId String @unique @map("student_id") @db.Char(24)

  // HOSILA (Σ payment.amount − Σ allocation − Σ refund + Σ adjustment),
  // tezlik uchun denormalizatsiya; financeReconcile job tasdiqlaydi.
  balance Decimal @default(0) @db.Decimal(14, 2)
  version Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("student_accounts")
}

// Qo'lda tuzatish — faqat audit izi bilan (sanoq farqi, eski qarzni yopish).
model StudentBalanceAdjustment {
  id        String  @id @db.Char(24)
  studentId String  @map("student_id") @db.Char(24)
  amount    Decimal @db.Decimal(14, 2) // ISHORALI
  reason    String

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([studentId, createdAt(sort: Desc)])
  @@map("student_balance_adjustments")
}

// Ota-onaga pul qaytarish (o'qishdan ketdi, depoziti ortib qoldi).
model Refund {
  id        String  @id @db.Char(24)
  studentId String  @map("student_id") @db.Char(24)
  accountId String  @map("account_id") @db.Char(24)
  amount    Decimal @db.Decimal(14, 2) // musbat
  reason    String

  refundedAt DateTime @map("refunded_at")

  isVoided   Boolean   @default(false) @map("is_voided")
  voidedAt   DateTime? @map("voided_at")
  voidedBy   String?   @map("voided_by") @db.Char(24)
  voidReason String    @default("") @map("void_reason")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")

  account PaymentAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([studentId, refundedAt(sort: Desc)])
  @@index([accountId, refundedAt(sort: Desc)])
  @@map("refunds")
}

// ─────────────────────────────────────────────
// O'ZGARISHLAR TARIXI (release notes)
// ─────────────────────────────────────────────
//
// ⚠️ BU BO'LIM PLATFORMAGA KO'CHDI — prisma/platform/schema.prisma.
// O'zgarishlar tarixi DASTURIY TA'MINOT haqida, filial haqida emas: bitta
// reliz barcha filiallarga bir vaqtda yetib boradi, ya'ni uni har filialda
// takrorlash noto'g'ri bo'lardi (va versiya raqami filialma-filial ajralib
// ketardi).
//
// `Changelog`, `ChangelogSettings`, `ChangelogNotification` va ularning
// enum'lari o'sha faylda.

// ─────────────────────────────────────────────
// INVENTAR — MODDIY-TEXNIK BAZA
// ─────────────────────────────────────────────
//
// Uch bosqichli domen, moliya moduli bilan AYNAN bir xil doktrinada:
//
//   1) XATLOV      — qaysi xonada nima va nechta bor  (InventoryStock)
//   2) MONITORING  — har kuni mas'ul shaxs hisoboti   (InventoryCheck)
//   3) UNDIRUV     — zarar → aybdorga qarz → to'lov    (InventoryDamage →
//                                              DamageCharge → DamagePayment)
//
// ⚠️ NIMA UCHUN ALOHIDA REGISTR, HISOB-FAKTURA EMAS.
// `MonthlyInvoice` — TARIF majburiyati va u muhrlangan fakt: uning summasi
// `proratedAmount − discountAmount` ga TENG bo'lishi `financeReconcile`
// invarianti (#4). Zararni o'sha qatorga qo'shsak, invariant birinchi
// singan partada buzilardi va "bu oy nega 2 400 000?" degan savolga
// hisob-fakturaning o'zidan javob chiqmasdi. Shuning uchun zarar —
// `PayrollEntry` uslubidagi MUSTAQIL majburiyat registri.
//
// ⚠️ `StudentAccount.balance` GA TEGILMAYDI. U invariant #2 bo'yicha
// AYNAN `Σ Payment.depositAmount` — ya'ni oldindan to'langan o'qish puli.
// Zarar qarzini o'sha balansga qo'shsak, depozit bilan zarar bir xaltaga
// tushib, "ota-onaga qancha qaytaramiz" degan savol javobsiz qolardi.
//
// ⚠️ AYBDOR — O'QUVCHI HAM, XODIM HAM. Shuning uchun `DamageCharge.personId`
// oddiy soft ref: `studentId`/`staffId` deb ikkiga bo'lish ikkita bir xil
// jadval va ikkita bir xil FIFO degani bo'lardi.

// Lokatsiya turi — hisobotdagi KESIM. Erkin matn bo'lsa "1-A sinf",
// "1a sinf", "1 A xona" uchta boshqa qator bo'lib ko'rinardi.
enum InventoryLocationType {
  classroom // sinf xonasi
  canteen // oshxona / ovqatlanish zali
  gym // sport zali
  library // kutubxona
  lab // laboratoriya
  office // xodim xonasi
  corridor // yo'lak, sanuzel, umumiy joy
  dorm // yotoqxona
  warehouse // ombor
  other
}

// Miqdor daftaridagi harakat turi — `AccountEntryType` ning aynan ko'zgusi.
// Ishora TIPGA BOG'LIQ va `assertMovementSigns` bilan tekshiriladi.
enum InventoryMovementType {
  initial // boshlang'ich xatlov (+)
  purchase // yangi jihoz keldi (+)
  damage // sindi/yaroqsiz (yaroqsiz +, yo'qolganda jami −)
  repair // ta'mirlandi — yaroqsizdan qaytdi (yaroqsiz −)
  write_off // hisobdan chiqarildi (jami −, yaroqsiz −)
  transfer_in // boshqa xonadan keldi (+)
  transfer_out // boshqa xonaga ketdi (−)
  adjustment // sanoq farqi (±) — YAGONA ikki tomonlama tip
  damage_revert // zarar bekor qilindi (teskari qator)
}

// Kunlik hisobot holati. `draft` — mas'ul to'ldirayotgan varaq (hech narsa
// harakatlanmagan), `submitted` — YUBORILGAN va MUHRLANGAN: shu paytda
// miqdor daftariga qatorlar yoziladi va zarar hodisalari tug'iladi.
enum InventoryCheckStatus {
  draft
  submitted
}

// Zarar turi. Ikkalasi ham puli bir xil, LEKIN XATLOVGA TA'SIRI BOSHQA:
// singan parta xonada turibdi (jami o'zgarmaydi, yaroqsiz ortadi),
// yo'qolgan piyola esa yo'q (jami kamayadi). Bitta maydonga qo'shsak,
// "xonada nechta stul bor" degan savol noto'g'ri javob berardi.
enum InventoryDamageKind {
  broken // sindi / yaroqsiz holatga keldi
  missing // yo'qoldi
}

// ZARAR SABABI — `kind` dan MUSTAQIL ikkinchi o'lchov.
//
// ⚠️ NIMA UCHUN `kind` GA QO'SHILMAGAN. `InventoryDamageKind` XATLOVGA
// TA'SIRNI bildiradi (broken → jami o'zgarmaydi/yaroqsiz ortadi,
// missing → jami kamayadi), sabab esa NIMA BO'LGANINI bildiradi.
// Ikkalasi bir enumga qo'shilsa, "yaroqlilik muddati tugadi" ni yozish
// uchun uning xatlovga ta'sirini ham tanlash kerak bo'lardi va bitta
// noto'g'ri tanlov "xonada nechta piyola bor" degan javobni buzardi.
//
// Toifa + erkin izoh — `StudentEnrollment` ning ketish sababi bilan aynan
// bir xil naqsh: toifa bo'lmasa "bu yil nechta jihoz yaroqlilik muddati
// tugagani uchun chiqdi" degan savolga javob bo'lmaydi, erkin matn
// bo'lmasa esa ro'yxatga sig'maydigan holat yozilmay qolardi.
enum InventoryDamageReason {
  broken // sindi / singan holatga keldi
  expired // yaroqlilik muddati tugadi
  worn_out // eskirdi, tabiiy yeyilish
  misused // noto'g'ri foydalanish natijasida
  lost // yo'qoldi
  stolen // o'g'irlandi
  other // boshqa — izoh MAJBURIY
}

enum InventoryDamageStatus {
  pending // aybdor hali aniqlanmagan
  charged // aybdor(lar)ga qarz yozilgan
  waived // maktab hisobidan — aybdor yo'q (tabiiy eskirish, forsmajor)
  cancelled // xato yozuv — bekor qilindi (sababi va aktyori bilan)
}

// `InvoiceStatus` / `PayrollStatus` bilan AYNAN bir xil — uchinchi holat
// to'plami kiritilmaydi, chunki `deriveStatus` uchalasiga bitta.
enum DamageChargeStatus {
  unpaid
  partial
  paid
  cancelled
}

// JIHOZ TOIFASI — `ExpenseCategory` ning aynan ko'zgusi: o'chirilmaydi,
// ARXIVLANADI (o'tgan zarar yozuvlari unga ishora qiladi).
model InventoryCategory {
  id   String @id @db.Char(24)
  name String @unique

  isActive   Boolean @default(true) @map("is_active")
  isArchived Boolean @default(false) @map("is_archived")
  sortOrder  Int     @default(0) @map("sort_order")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items InventoryItem[]

  @@index([isArchived, isActive, sortOrder])
  @@map("inventory_categories")
}

// JIHOZ NOMI — katalog. "Parta", "Piyola", "Proyektor", "Qoshiq".
//
// ⚠️ NARX VERSIYALANMAYDI — va bu `Tariff` bilan ATAYLAB QARAMA-QARSHI.
// Tarifda narx versiyalanadi, chunki hisob-faktura KELAJAKDA, qoidaga
// qarab shakllanadi: "avgustdan boshlab 600 000". Zararda esa narx
// O'TMISHDAGI BITTA ONGA tegishli — parta AYNAN 12-sentabrda sindi.
// Shuning uchun narx hodisa paytida `InventoryDamage.unitPrice` ga
// MUHRLANADI va katalogdagi qiymat keyin o'zgarsa ham o'tgan zararga
// tegilmaydi. Versiya jadvali bu yerda ortiqcha murakkablik bo'lardi.
model InventoryItem {
  id         String @id @db.Char(24)
  categoryId String @map("category_id") @db.Char(24)

  name String @unique
  // "dona", "komplekt", "juft", "kg" — miqdor BUTUN son bo'lgani uchun
  // faqat YORLIQ. Kasrli o'lchov (2.5 kg un) bu domenda yo'q: xatlov
  // sanaladigan buyumlar haqida.
  unit String @default("dona")

  // Zararning STANDART narxi (bittasi uchun). Nol qonuniy: qiymati
  // hisoblanmaydigan buyum (masalan bepul tarqatilgan daftar) uchun
  // zarar qayd etiladi-yu, pul undirilmaydi.
  unitPrice Decimal @default(0) @map("unit_price") @db.Decimal(14, 2)

  description String  @default("")
  isArchived  Boolean @default(false) @map("is_archived")
  sortOrder   Int     @default(0) @map("sort_order")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category      InventoryCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  stocks        InventoryStock[]
  damages       InventoryDamage[]
  movements     InventoryMovement[]
  transferLines InventoryTransferLine[]

  @@index([categoryId, isArchived, sortOrder])
  @@index([isArchived, name])
  @@map("inventory_items")
}

// XONA (lokatsiya) — xatlovning birinchi o'lchovi.
//
// `classId` — IXTIYORIY soft ref: "1-A sinf xonasi" odatda sinfga tegishli,
// lekin oshxona va yo'lak hech qaysi sinfga tegishli emas. Sinf o'chirilsa
// xona yo'qolmasligi kerak, shuning uchun FK emas.
model InventoryLocation {
  id   String                @id @db.Char(24)
  name String                @unique
  type InventoryLocationType @default(classroom)

  classId       String? @map("class_id") @db.Char(24)
  // MAS'UL SHAXS — kunlik hisobotni kim yuboradi (soft ref → User).
  // U AYBDOR EMAS: mas'ullik hisobot berishga tegishli, zarar esa
  // aniq odamga alohida yoziladi (`DamageCharge`).
  responsibleId String? @map("responsible_id") @db.Char(24)

  note       String  @default("")
  isArchived Boolean @default(false) @map("is_archived")
  sortOrder  Int     @default(0) @map("sort_order")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stocks        InventoryStock[]
  checks        InventoryCheck[]
  damages       InventoryDamage[]
  movements     InventoryMovement[]
  transfersFrom InventoryTransfer[] @relation("InventoryTransferFrom")
  transfersTo   InventoryTransfer[] @relation("InventoryTransferTo")

  @@index([isArchived, type, sortOrder])
  @@index([responsibleId])
  @@index([classId])
  @@map("inventory_locations")
}

// XATLOV QATORI — "shu xonada shu jihozdan nechta bor".
//
// `quantity` va `brokenQuantity` — HOSILA qiymatlar: ular `InventoryMovement`
// daftarining yig'indisi. Denormalizatsiya tezlik uchun, `financeReconcile`
// job'i har kecha tasdiqlaydi (`PaymentAccount.balance` bilan bir xil naqsh).
//
// Yaroqli miqdor = quantity − brokenQuantity va u USTUN EMAS: ikkita
// haqiqat manbai bo'lib qolardi, service'da hisoblanadi.
model InventoryStock {
  id         String @id @db.Char(24)
  locationId String @map("location_id") @db.Char(24)
  itemId     String @map("item_id") @db.Char(24)

  quantity       Int @default(0) // jami (yaroqsizlari ham shu ichida)
  brokenQuantity Int @default(0) @map("broken_quantity") // ta'mirlanmagan yaroqsizlar

  note String @default("")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  location  InventoryLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  item      InventoryItem        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  movements InventoryMovement[]
  damages   InventoryDamage[]
  lines     InventoryCheckLine[]

  // Bitta xonada bitta jihozdan BITTA qator — "Parta 20 ta" va "Parta 5 ta"
  // yonma-yon tursa, "nechta parta bor" savoli javobsiz qolardi.
  @@unique([locationId, itemId])
  @@index([itemId])
  @@index([locationId, brokenQuantity])
  @@map("inventory_stocks")
}

// MIQDOR DAFTARI — QAT'IY APPEND-ONLY, `AccountEntry` ning aynan ko'zgusi.
//
// Xato yozuv tahrirlanmaydi ham, o'chirilmaydi ham: teskari (kompensatsiya)
// qatori yoziladi. Daftarga yozadigan YAGONA nuqta — `postMovement()`,
// va uning shakli MAJBURIY:
//   update({ quantity: { increment } }) → QAYTGAN qiymat `quantityAfter`.
// "O'qi → hisobla → yoz" aynan yo'qolgan yangilanish shakli va bu yerda
// "20 ta parta bor edi, ikki hisobot bir vaqtda kelib 19 ta bo'lib qoldi"
// degan holatga olib kelardi.
model InventoryMovement {
  id String @id @db.Char(24)

  // QO'SHILISH tartibi — `quantityAfter` AYNAN shunga bog'liq. Orqaga
  // sanalgan hisobot `occurredAt` bo'yicha ro'yxat o'rtasiga tushadi va
  // running qoldiq ustunini ma'nosiz qilardi. Registr `seq`, hisobot
  // `occurredAt` bo'yicha.
  seq BigInt @default(autoincrement())

  stockId    String @map("stock_id") @db.Char(24)
  // Denormalizatsiya: "shu xonada bu oy nima bo'ldi" hisoboti `stockId`
  // orqali join qilmasin.
  locationId String @map("location_id") @db.Char(24)
  itemId     String @map("item_id") @db.Char(24)

  type InventoryMovementType

  // ISHORALI: + keldi, − ketdi. Ikkalasi bir vaqtda 0 bo'lishi mumkin emas.
  quantityDelta Int @map("quantity_delta")
  brokenDelta   Int @default(0) @map("broken_delta")

  // Post-image — `update({ increment })` dan QAYTGAN qiymat
  quantityAfter Int @map("quantity_after")
  brokenAfter   Int @map("broken_after")

  occurredAt DateTime @map("occurred_at")

  checkId               String? @map("check_id") @db.Char(24)
  damageId              String? @map("damage_id") @db.Char(24)
  // O'TKAZMA HUJJATI — ikkala qator (chiqim va kirim) bitta `transferId`
  // ga ishora qiladi. `counterpartLocationId` faqat "qaysi xonaga" degan
  // savolga javob beradi, hujjat esa "kim topshirdi, kim qabul qildi,
  // qanday izoh bilan" degan savollarni ham saqlaydi.
  transferId            String? @map("transfer_id") @db.Char(24)
  // Xonalar orasidagi o'tkazmada juftini ko'rsatadi (ikki qator, bitta hodisa)
  counterpartLocationId String? @map("counterpart_location_id") @db.Char(24)

  note      String   @default("")
  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")

  // Restrict, Cascade EMAS: Cascade xatlov tarixini xona bilan birga
  // olib ketardi (`AccountEntry` bilan bir xil mulohaza).
  stock    InventoryStock     @relation(fields: [stockId], references: [id], onDelete: Restrict)
  location InventoryLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  item     InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  check    InventoryCheck?    @relation(fields: [checkId], references: [id], onDelete: Restrict)
  damage   InventoryDamage?   @relation(fields: [damageId], references: [id], onDelete: Restrict)
  transfer InventoryTransfer? @relation(fields: [transferId], references: [id], onDelete: Restrict)

  @@index([stockId, seq(sort: Desc)]) // registr + running qoldiq
  @@index([locationId, occurredAt(sort: Desc)])
  @@index([itemId, occurredAt(sort: Desc)])
  @@index([occurredAt])
  @@index([checkId])
  @@index([damageId])
  @@index([transferId])
  @@map("inventory_movements")
}

// JIHOZLARNI O'TKAZISH — TOPSHIRISH-QABUL QILISH AKTI.
//
// `AccountTransfer` ning aynan ko'zgusi: bitta HODISA, ikkita daftar
// qatori. U yerda pul bir kassadan ikkinchisiga o'tadi, bu yerda jihoz
// bir xonadan ikkinchisiga.
//
// ⚠️ NIMA UCHUN ALOHIDA HUJJAT, IKKITA `InventoryMovement` EMAS.
// Daftar qatori faqat MIQDORNI biladi. O'tkazma esa uch narsani saqlashi
// kerak: qaysi xonaga, KIMGA topshirildi va NIMA UCHUN. Bularni daftar
// qatorining `note` matniga yozsak, "shu xodimga nima topshirilgan"
// degan savolga javob matn qidiruvi bo'lib qolardi.
//
// ⚠️ BIR AKTDA BIR NECHTA JIHOZ. Amalda "1-A dan 2-B ga 10 ta parta va
// 20 ta stul" bitta hodisa: bitta izoh, bitta topshiruvchi, bitta sana.
// Har birini alohida o'tkazma qilish uchala maydonni uch marta
// takrorlashni talab qilardi (`addStock` ning `lines[]` bilan bir xil
// mulohaza).
//
// ⚠️ BEKOR QILISH YO'Q va bu ATAYLAB. Xato o'tkazma TESKARI o'tkazma
// bilan tuzatiladi — daftar append-only bo'lgani uchun baribir ikkita
// yangi qator yoziladi, ya'ni "bekor qilish" tugmasi shu ikki qatorni
// ko'rinmas qilardi. Teskari o'tkazmada esa izohga sabab yoziladi.
model InventoryTransfer {
  id             String @id @db.Char(24)
  fromLocationId String @map("from_location_id") @db.Char(24)
  toLocationId   String @map("to_location_id") @db.Char(24)

  // KIMGA TOPSHIRILDI — ixtiyoriy soft ref → User (xodim).
  //
  // Ixtiyoriy, chunki "singan partalar omborga" degan o'tkazmada aniq
  // qabul qiluvchi bo'lmasligi mumkin. Berilganda esa bu JAVOBGARLIK
  // fakti: "10 ta parta Aliyevga topshirildi".
  //
  // ⚠️ Bu `InventoryLocation.responsibleId` NI O'ZGARTIRMAYDI. Xona
  // mas'uli — kim kunlik hisobot beradi degan alohida qaror; uni
  // o'tkazma bilan jimgina almashtirsak, hisobot ertasiga boshqa odamdan
  // talab qilinardi.
  toPersonId     String? @map("to_person_id") @db.Char(24)
  personSnapshot Json?   @map("person_snapshot")

  occurredAt DateTime @map("occurred_at")
  note       String   @default("")

  // HOSILA sanoqchilar — registr ekranida har bir akt uchun satrlarni
  // o'qimaslik uchun. Yaratishda bir marta hisoblanadi va o'zgarmaydi
  // (akt muhrlangan, `InventoryCheck` sanoqchilari bilan bir xil qaror).
  linesCount    Int @default(0) @map("lines_count")
  totalQuantity Int @default(0) @map("total_quantity")

  // Xona qayta nomlansa/arxivlansa ham akt o'z matnini saqlaydi
  fromSnapshot Json @map("from_snapshot")
  toSnapshot   Json @map("to_snapshot")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")

  fromLocation InventoryLocation       @relation("InventoryTransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   InventoryLocation       @relation("InventoryTransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  lines        InventoryTransferLine[]
  movements    InventoryMovement[]

  @@index([occurredAt(sort: Desc)])
  @@index([fromLocationId, occurredAt(sort: Desc)])
  @@index([toLocationId, occurredAt(sort: Desc)])
  @@index([toPersonId, occurredAt(sort: Desc)])
  @@map("inventory_transfers")
}

// O'tkazma aktining bitta jihoz bo'yicha satri.
//
// `itemName`/`unit` — SURAT: jihoz qayta nomlansa ham akt o'z matnida
// qoladi (`InventoryCheckLine` bilan bir xil qaror).
model InventoryTransferLine {
  id         String @id @db.Char(24)
  transferId String @map("transfer_id") @db.Char(24)
  itemId     String @map("item_id") @db.Char(24)

  itemName String @map("item_name")
  unit     String @default("dona")

  quantity       Int
  // Yaroqsizlaridan nechtasi — "singan partalar omborga" holati.
  // `quantity` ICHIDA (undan ayrilmaydi): jami 10 ta ko'chirildi,
  // shundan 3 tasi singan.
  brokenQuantity Int @default(0) @map("broken_quantity")

  note String @default("")

  createdAt DateTime @default(now()) @map("created_at")

  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  // Bitta aktda bitta jihoz BIR MARTA — ikkita qator bir-birini
  // "to'ldirib", nima ko'chirilgani noaniq bo'lib qolardi
  @@unique([transferId, itemId])
  @@index([itemId])
  @@map("inventory_transfer_lines")
}

// KUNLIK HISOBOT — mas'ul shaxsning "bugun shu xonada nima holatda" akti.
//
// `@@unique([locationId, date])` — IDEMPOTENTLIK: bir kunda bir xonaga
// ikkita hisobot bo'lsa, "bugun nechta sindi" savoli ikki xil javob
// berardi. Ikkinchi marta ochilganda mavjud varaq qaytariladi.
//
// `date` — `@db.Date`, ya'ni vaqt komponenti STRUKTURA BO'YICHA yo'q
// (`StudentEnrollment.startDate` bilan bir xil g'oya). Faqat `getUTC*`
// bilan o'qiladi.
model InventoryCheck {
  id         String   @id @db.Char(24)
  locationId String   @map("location_id") @db.Char(24)
  date       DateTime @db.Date

  status InventoryCheckStatus @default(draft)

  // Kim hisobot berdi (soft ref → User). Xona mas'ulidan FARQ QILISHI
  // mumkin: mas'ul ta'tilda bo'lsa o'rniga boshqa xodim yuboradi.
  reportedBy String @map("reported_by") @db.Char(24)

  note String @default("")

  // ⚠️ HISOBOT YUBORILGANDA MUHRLANADI. Undan keyin satrlar tahrirlanmaydi:
  // miqdor daftariga qatorlar yozilib bo'lgan, ularni "orqaga qaytarish"
  // uchun teskari qator kerak — bu esa alohida, ko'rinadigan amal.
  submittedAt DateTime? @map("submitted_at")

  // HOSILA sanoqchilar — ro'yxat ekranida har bir hisobot uchun satrlarni
  // o'qimaslik uchun. Yuborish paytida bir marta hisoblanadi va o'zgarmaydi.
  linesCount    Int     @default(0) @map("lines_count")
  brokenCount   Int     @default(0) @map("broken_count")
  missingCount  Int     @default(0) @map("missing_count")
  repairedCount Int     @default(0) @map("repaired_count")
  damageAmount  Decimal @default(0) @map("damage_amount") @db.Decimal(14, 2)

  // Xona arxivlansa/qayta nomlansa ham o'tgan hisobot o'qilishi kerak
  locationSnapshot Json @map("location_snapshot")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  location  InventoryLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lines     InventoryCheckLine[]
  damages   InventoryDamage[]
  movements InventoryMovement[]

  @@unique([locationId, date])
  @@index([date(sort: Desc), status])
  @@index([locationId, date(sort: Desc)])
  @@index([reportedBy, date(sort: Desc)])
  @@map("inventory_checks")
}

// Hisobotning bitta jihoz bo'yicha satri.
//
// `expectedQuantity` — varaq OCHILGAN paytdagi xatlov surati. U bilan
// haqiqiy sanoq taqqoslanadi: farq "yo'qolgan" degani.
model InventoryCheckLine {
  id      String @id @db.Char(24)
  checkId String @map("check_id") @db.Char(24)
  stockId String @map("stock_id") @db.Char(24)
  itemId  String @map("item_id") @db.Char(24)

  // Jihoz qayta nomlansa ham hisobot o'z matnini saqlaydi
  itemName String @map("item_name")
  unit     String @default("dona")

  expectedQuantity Int @map("expected_quantity") // varaq ochilgandagi jami
  expectedBroken   Int @default(0) @map("expected_broken") // oldindan yaroqsiz bo'lganlari

  // BUGUNGI o'zgarish — mas'ul shaxs kiritadigan uchta raqam
  brokenQuantity   Int @default(0) @map("broken_quantity") // bugun singani
  missingQuantity  Int @default(0) @map("missing_quantity") // bugun yo'qolgani
  repairedQuantity Int @default(0) @map("repaired_quantity") // bugun ta'mirlangani

  // SABAB — har bir tur uchun ALOHIDA va bu ataylab.
  //
  // Bitta satrda ikkala tur bir vaqtda bo'lishi mumkin ("3 tasi sindi,
  // 1 tasi yo'qoldi") va ular BOSHQA-BOSHQA zarar hodisasiga aylanadi.
  // Bitta umumiy `reason` ustuni bo'lsa, yuborishda ikkala hodisaga bir
  // xil sabab muhrlanib, "nega yo'qoldi?" degan savolga "sindi" deb
  // javob berilardi.
  //
  // NULL faqat tegishli miqdor NOL bo'lganda qonuniy — miqdor kiritilgan
  // bo'lsa sabab MAJBURIY (`inventoryCheck.service.js`).
  brokenReason  InventoryDamageReason? @map("broken_reason")
  missingReason InventoryDamageReason? @map("missing_reason")

  note        String @default("")
  // attachments[] — { key, url, type, originalName, sizeBytes }
  // Rasm/tafsilot: "qanday singan" degan savolga javob (Penalty uslubi)
  attachments Json   @default("[]")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  check InventoryCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  stock InventoryStock @relation(fields: [stockId], references: [id], onDelete: Restrict)

  // Bitta hisobotda bitta jihoz BIR MARTA
  @@unique([checkId, itemId])
  @@index([stockId])
  @@map("inventory_check_lines")
}

// ZARAR HODISASI — MUHRLANGAN FAKT (`MonthlyInvoice` doktrinasi).
//
//   amount = quantity × unitPrice        ← MUHRLANADI
//
// ⚠️ `amount` NI O'ZGARTIRADIGAN ENDPOINT YO'Q. Katalogdagi narx keyin
// to'g'rilansa bu qatorga tegilmaydi: hodisa o'z kunidagi narxda qoladi.
// Xato bo'lsa — bekor qilinadi (`cancelled`) va qaytadan kiritiladi.
model InventoryDamage {
  id         String  @id @db.Char(24)
  locationId String  @map("location_id") @db.Char(24)
  itemId     String  @map("item_id") @db.Char(24)
  stockId    String  @map("stock_id") @db.Char(24)
  // Kunlik hisobotdan tug'ilgan bo'lsa — manbasi
  checkId    String? @map("check_id") @db.Char(24)

  kind   InventoryDamageKind   @default(broken)
  status InventoryDamageStatus @default(pending)

  // SABAB — `kind` dan MUSTAQIL o'lchov (`InventoryDamageReason` izohiga
  // qarang). Hodisa bilan birga MUHRLANADI: keyin "aslida eskirgan ekan"
  // deb o'zgartirilmaydi, zarar bekor qilinib qayta kiritiladi.
  //
  // `@default(broken)` — faqat MIGRATSIYA uchun (eski qatorlar sababsiz
  // yozilgan). Yangi hodisada sabab MAJBURIY va service tekshiradi.
  // Erkin izoh alohida ustun EMAS: u `description` da, ya'ni "boshqa"
  // tanlanganda `description` majburiy bo'ladi. Ikkinchi izoh ustuni
  // bo'lsa, xodim qaysi biriga yozishini bilmasdi.
  reason InventoryDamageReason @default(broken)

  quantity  Int
  // Hodisa PAYTIDAGI narx — katalogdan olingan surat
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
  amount    Decimal @db.Decimal(14, 2) // = quantity × unitPrice

  // HOSILA: Σ (bekor qilinmagan) DamageCharge.amount. Aybdorlarga
  // yozilgan ulush zarardan OSHIB KETMASLIGI service'da tekshiriladi
  // va `financeReconcile` har kecha tasdiqlaydi.
  chargedAmount Decimal @default(0) @map("charged_amount") @db.Decimal(14, 2)

  description String @default("")
  // attachments[] — { key, url, type, originalName, sizeBytes }
  attachments Json   @default("[]")

  occurredAt DateTime @map("occurred_at")
  reportedBy String   @map("reported_by") @db.Char(24)

  itemSnapshot     Json @map("item_snapshot")
  locationSnapshot Json @map("location_snapshot")

  // MAKTAB HISOBIDAN — aybdor yo'q (tabiiy eskirish, forsmajor).
  // "Bekor qilish" EMAS: zarar bo'lgan, faqat undirilmaydi. Ikkalasini
  // bitta holatga qo'shsak, "bu yil qancha zarar ko'rdik" degan savolga
  // javob past chiqardi.
  waiveReason String    @default("") @map("waive_reason")
  waivedAt    DateTime? @map("waived_at")
  waivedBy    String?   @map("waived_by") @db.Char(24)

  cancelReason String    @default("") @map("cancel_reason")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by") @db.Char(24)

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  location  InventoryLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  item      InventoryItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  stock     InventoryStock      @relation(fields: [stockId], references: [id], onDelete: Restrict)
  check     InventoryCheck?     @relation(fields: [checkId], references: [id], onDelete: Restrict)
  charges   DamageCharge[]
  movements InventoryMovement[]

  @@index([occurredAt(sort: Desc)])
  @@index([status, occurredAt(sort: Desc)])
  @@index([locationId, occurredAt(sort: Desc)])
  @@index([itemId, occurredAt(sort: Desc)])
  @@index([reason, occurredAt(sort: Desc)])
  @@index([checkId])
  @@map("inventory_damages")
}

// AYBDORGA YOZILGAN QARZ — `PayrollEntry` ning aynan ko'zgusi, faqat pul
// TESKARI yo'nalishda harakatlanadi (biz emas, bizga to'lanadi).
//
// Bitta zararda bir NECHTA aybdor bo'lishi mumkin ("derazani uchovi
// birga sindirdi") — shuning uchun `InventoryDamage` 1..N `DamageCharge`.
// Ulushlar yig'indisi zarardan oshmasligi service'da tekshiriladi.
//
// ⚠️ SUMMA MUHRLANADI. Uni o'zgartiradigan endpoint YO'Q: xato bo'lsa
// qarz bekor qilinadi va yangisi yoziladi (`MonthlyInvoice` doktrinasi).
model DamageCharge {
  id       String @id @db.Char(24)
  damageId String @map("damage_id") @db.Char(24)

  // soft ref → User. O'quvchi ham, xodim ham bo'lishi mumkin — shuning
  // uchun `studentId`/`staffId` deb ikkiga bo'linmagan.
  personId       String @map("person_id") @db.Char(24)
  // Hodisa paytidagi rol — keyin o'zgarsa ham hisobot kesimi buzilmaydi
  personRole     String @map("person_role")
  // { firstName, lastName, username, role, className }
  personSnapshot Json   @map("person_snapshot")

  // Nechta jihoz uchun javobgar — MA'LUMOT uchun (summa mustaqil muhrlanadi:
  // uch kishi bittada 1/3 dan to'lashi mumkin)
  quantity Int @default(0)

  amount     Decimal @db.Decimal(14, 2)
  paidAmount Decimal @default(0) @map("paid_amount") @db.Decimal(14, 2)

  status DamageChargeStatus @default(unpaid)

  note    String    @default("")
  // Qachongacha to'lansin — eslatma va "muddati o'tgan" kesimi uchun
  dueDate DateTime? @map("due_date") @db.Date

  paidAt DateTime? @map("paid_at")

  cancelReason String    @default("") @map("cancel_reason")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by") @db.Char(24)

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  damage      InventoryDamage    @relation(fields: [damageId], references: [id], onDelete: Restrict)
  allocations DamageAllocation[]

  @@index([personId, status])
  @@index([personId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([damageId])
  @@index([dueDate])
  @@map("damage_charges")
}

// ZARAR UNDIRUVI — `SalaryPayment` ning ko'zgusi, LEKIN PUL KASSAGA KIRADI.
//
// ⚠️ DEPOZIT YO'Q va AVANS YO'Q: qarzdan ortiq to'lov RAD ETILADI.
// O'quvchining o'qish to'lovida ortiqcha pul depozitga tushadi, chunki
// keyingi oy majburiyati ANIQ keladi. Zararda esa "keyingi zarar" degan
// narsa yo'q — ortiqcha pulni saqlaydigan joy ochilsa, u ikkinchi
// "hamyon" bo'lib, depozit bilan chalkashardi.
//
// Bo'lib to'lash MUMKIN: bitta qarz bir necha marta to'lanadi
// (`partial` → `paid`).
model DamagePayment {
  id String @id @db.Char(24)

  // Chek raqami — `Payment` bilan bir xil mulohaza: ota-onaga aytiladigan
  // RAQAM hozir qo'shiladi, keyin retro-raqamlash imkonsiz.
  receiptNo Int @unique @default(autoincrement()) @map("receipt_no")

  personId  String @map("person_id") @db.Char(24)
  accountId String @map("account_id") @db.Char(24)

  amount Decimal @db.Decimal(14, 2) // musbat; daftarga MUSBAT tushadi

  paidAt DateTime @map("paid_at")
  note   String   @default("")

  personSnapshot Json @map("person_snapshot")

  isVoided   Boolean   @default(false) @map("is_voided")
  voidedAt   DateTime? @map("voided_at")
  voidedBy   String?   @map("voided_by") @db.Char(24)
  voidReason String    @default("") @map("void_reason")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account     PaymentAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  allocations DamageAllocation[]
  entries     AccountEntry[]

  @@index([personId, paidAt(sort: Desc)])
  @@index([accountId, paidAt(sort: Desc)])
  @@index([paidAt])
  @@map("damage_payments")
}

// To'lov qaysi qarzni yopdi — `SalaryAllocation` ning aynan ko'zgusi.
model DamageAllocation {
  id        String @id @db.Char(24)
  paymentId String @map("payment_id") @db.Char(24)
  chargeId  String @map("charge_id") @db.Char(24)
  personId  String @map("person_id") @db.Char(24)

  amount Decimal @db.Decimal(14, 2)

  appliedAt DateTime @map("applied_at")

  isVoided  Boolean   @default(false) @map("is_voided")
  voidedAt  DateTime? @map("voided_at")
  createdAt DateTime  @default(now()) @map("created_at")

  payment DamagePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  charge  DamageCharge  @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@index([chargeId, isVoided])
  @@index([paymentId])
  @@index([personId, appliedAt(sort: Desc)])
  @@map("damage_allocations")
}

// Inventar bo'limining sozlamalari — HAR FILIALDA ALOHIDA.
model InventorySettings {
  id String @id @default("singleton") @db.VarChar(24)

  // Kunlik monitoring yoqilganmi. O'chirilsa eslatma ketmaydi va
  // "hisobot bermagan xonalar" kesimi hisoblanmaydi.
  dailyCheckEnabled Boolean @default(true) @map("daily_check_enabled")
  // Eslatma vaqti — "HH:mm", Toshkent devor-soati. Cron ifodasi QOTIB
  // QOLMASLIGI uchun vaqt bazadan o'qiladi (changelog job'i bilan bir xil).
  reminderTime      String  @default("17:00") @map("reminder_time")
  // Eslatma Telegramga ketadimi
  reminderEnabled   Boolean @default(false) @map("reminder_enabled")

  // Zarar qayd etilganda rasm MAJBURIYMI. "Bugun 1 ta sindi" degan
  // yozuv rasmsiz bo'lsa, keyin uni tekshirib bo'lmaydi.
  requirePhoto Boolean @default(false) @map("require_photo")

  // Undiruv odatda qaysi to'lov turiga tushadi (kassirning ishini
  // qisqartiradi; tanlash baribir mumkin)
  defaultAccountId String? @map("default_account_id") @db.Char(24)

  updatedBy String?  @map("updated_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("inventory_settings")
}
