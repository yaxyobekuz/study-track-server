  addedBy  String   @map("added_by") @db.Char(24)
  addedAt  DateTime @default(now()) @map("added_at")
  position Int

  result TestResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@map("test_result_extra_points")
}

// testResult.perQuestion[] — ochiq savol baholash tafsiloti
model TestResultPerQuestion {
  id            String            @id @db.Char(24)
  resultId      String            @map("result_id") @db.Char(24)
  questionId    String            @map("question_id") @db.Char(24)
