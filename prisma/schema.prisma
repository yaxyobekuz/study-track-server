}

// Chegirma qanday hisoblanadi. Foizlar QO'SHILADI (ikkita 20% = 40%, 36% emas)
// va fixed'dan OLDIN qo'llanadi — helpers/discount.helpers.js.

// Kassa daftaridagi harakat turi. Ishora TIPGA BOG'LIQ va tekshiriladi
// (money.helpers.js → assertSignMatchesType).
enum AccountEntryType {
  payment // + o'quvchidan to'lov
  payment_void // − to'lov bekor qilindi
  transfer_in // + boshqa hisobdan keldi
  transfer_out // − boshqa hisobga ketdi
  refund // − ota-onaga qaytarildi
  refund_void // + qaytarish bekor qilindi
  adjustment // ± qo'lda to'g'rilash (sanoq farqi)
  external_income // + o'quvchi to'lovi BO'LMAGAN kirim (ijara, sotuv, homiylik)
  external_income_void // − tashqi kirim bekor qilindi
  salary_payment // − xodimga oylik to'landi
  salary_payment_void // + oylik to'lovi bekor qilindi
  expense // − xarajat (kommunal, ta'mirlash, jihoz)
  expense_void // + xarajat bekor qilindi
  // MODDIY ZARAR — aybdordan undirilgan pul. XARAJATNING TESKARISI:
  // xarajat jihozni ta'mirlashga ketgan pul (−), bu esa o'sha zararni
  // qoplagan odamdan tushgan pul (+). Ikkalasi bir hodisaning ikki tomoni,
  // shuning uchun alohida tip: hisobotda "qancha zarar qopladik" degan
  // savolga `external_income` bilan aralashmagan javob kerak.
  damage_payment // + moddiy zarar undirildi
  damage_payment_void // − undiruv bekor qilindi
}

// Oylik qanday hisoblanadi. Hozircha faqat `fixed` — soatbay, darsbay va
// guruh tushumidan foiz kelajakda qo'shiladi (baza shunga tayyor).
enum SalaryType {
  fixed
}

// Oylik majburiyatining holati — `InvoiceStatus` bilan bir xil.
enum PayrollStatus {
  unpaid
  partial
  paid
  cancelled
}

// To'lov hisob-fakturaga QACHON tushdi. Depozit ALOHIDA mexanizm emas —
// keyingi oy depozitdan yopilganda AYNAN shu jadvalga `deposit` manbali
// yana bir qator yoziladi.
enum AllocationSource {
  payment // kassir to'lovni qabul qilgan payt
  deposit // keyinroq, oldindan to'langan qoldiqdan
}

