  binding TestBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@index([bindingId, studentId])
  @@map("test_binding_reopen_grants")
}

model TestSession {
  id            String            @id @db.Char(24)
  bindingId     String            @map("binding_id") @db.Char(24)
  testId        String            @map("test_id") @db.Char(24)
  studentId     String            @map("student_id") @db.Char(24)
  seasonId      String            @map("season_id") @db.Char(24)
  attemptNumber Int               @default(1) @map("attempt_number")
  status        TestSessionStatus @default(in_progress)
  startedAt     DateTime          @default(now()) @map("started_at")
  expiresAt     DateTime          @map("expires_at")
  submittedAt   DateTime?         @map("submitted_at")
  gradingMin    Int?              @map("grading_min")
  gradingMax    Int?              @map("grading_max")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  questions TestSessionQuestion[]
  answers   TestSessionAnswer[]

  @@unique([bindingId, studentId, attemptNumber])
  @@index([studentId, seasonId])
  @@index([bindingId])
  @@index([testId])
  @@index([status, expiresAt])
  @@map("test_sessions")
}

// testSession.questions[] — muzlatilgan savol snapshot'i
model TestSessionQuestion {
  id              String       @id @db.Char(24)
  sessionId       String       @map("session_id") @db.Char(24)
  questionId      String       @map("question_id") @db.Char(24) // proveniyans
  type            QuestionType
  text            String?
  // attachment snapshot
  image           Json?
  difficulty      Difficulty   @default(medium)
  points          Float        @default(0)
  correctOptionId String?      @map("correct_option_id") @db.Char(24) // maxfiy: select bilan boshqariladi
  position        Int

  session TestSession                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  options TestSessionQuestionOption[]

  @@index([sessionId])
  @@map("test_session_questions")
}

model TestSessionQuestionOption {
  id            String  @id @db.Char(24)
  questionRowId String  @map("question_row_id") @db.Char(24)
  optionId      String  @map("option_id") @db.Char(24) // original variant _id
  text          String?
  image         Json?
  position      Int

  questionRow TestSessionQuestion @relation(fields: [questionRowId], references: [id], onDelete: Cascade)

  @@index([questionRowId])
  @@map("test_session_question_options")
}

model TestSessionAnswer {
  id               String   @id @db.Char(24)
  sessionId        String   @map("session_id") @db.Char(24)
  questionId       String   @map("question_id") @db.Char(24)
  selectedOptionId String?  @map("selected_option_id") @db.Char(24)
  textAnswer       String?  @map("text_answer")
  answeredAt       DateTime @default(now()) @map("answered_at")

  session TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("test_session_answers")
}

model TestResult {
  id                String           @id @db.Char(24)
  sessionId         String           @unique @map("session_id") @db.Char(24)
  bindingId         String           @map("binding_id") @db.Char(24)
  testId            String           @map("test_id") @db.Char(24)
  studentId         String           @map("student_id") @db.Char(24)
  seasonId          String           @map("season_id") @db.Char(24)
  classId           String?          @map("class_id") @db.Char(24)
  subjectId         String           @map("subject_id") @db.Char(24)
  autoGradedScore   Float            @default(0) @map("auto_graded_score")
  manualGradedScore Float            @default(0) @map("manual_graded_score")
  finalScore        Float            @default(0) @map("final_score")
  gradingMin        Int?             @map("grading_min")
  gradingMax        Int?             @map("grading_max")
  passed            Boolean          @default(false)
  status            TestResultStatus @default(pending)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  extraPoints TestResultExtraPoint[]
  perQuestion TestResultPerQuestion[]

  @@index([testId])
  @@index([bindingId])
  @@index([studentId, seasonId])
  @@index([status])
  @@index([seasonId, subjectId])
  @@map("test_results")
}

// testResult.extraPoints[] (_id:true — individual CRUD)
model TestResultExtraPoint {
