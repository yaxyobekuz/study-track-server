  // { lat, lng, accuracy }
  checkInLocation  Json?            @map("check_in_location")
  checkOutLocation Json?            @map("check_out_location")
  locationWarning  Boolean          @default(false) @map("location_warning")
  outOfOffice      Boolean          @default(false) @map("out_of_office")
  penaltyApplied   Boolean          @default(false) @map("penalty_applied")
