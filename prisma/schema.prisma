  partial // Qisman to'langan (0 < paidAmount < amount)
  paid // To'langan (paidAmount >= amount)
  cancelled // Bekor qilingan — yagona "o'chirish" yo'li, sabab va aktyor bilan
}

// Majburiyatni kim shakllantirdi — auditda "qarz qayerdan paydo bo'ldi?".
enum InvoiceSource {
