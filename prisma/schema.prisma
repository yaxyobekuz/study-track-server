// Study-Track — PostgreSQL (Prisma) schema.
//
// Migratsiya: MongoDB (Mongoose) → PostgreSQL.
//  - ID: String @db.Char(24) — eski MongoDB ObjectId hex qiymatlari saqlanadi.
//    Yangi yozuvlar uchun ID config/prisma.js dagi Client Extension bilan generatsiya qilinadi.
//  - Naming: model field'lari camelCase; PostgreSQL ustunlari snake_case (@map),
//    jadvallar snake_case ko'plik (@@map).
//  - User.role oddiy String (Role.value ga ishora qiladi, lekin FK emas —
//    User↔Role doiraviy bog'liqligi va seed tartibini soddalashtirish uchun;
//    validatsiya service qatlamida).
//  - Embedded arraylar: query/update qilinadiganlar alohida jadval;
//    faqat o'qiladigan snapshot/log/Map → Json (JSONB).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUM'LAR
// ─────────────────────────────────────────────

enum Gender {
  male
  female
}

enum AttendanceStatus {
  present
  late
  absent
  excused
}

enum ExcuseRequestType {
  advance
  after
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum TaskStatus {
  pending
  extended
  pending_rejected
  stopped
  completed
  pending_review
}

enum PenaltyType {
  penalty
  reduction
}

enum QueueStatus {
  pending
  processing
  completed
  failed
}

enum CoinTransactionType {
  daily
  weekly_school_bonus
  weekly_class_bonus
  market_purchase
  market_refund
  holiday_bonus
  manual_give
  manual_take
  premium_purchase
  fine_reduction_purchase
  season_absolute_reward
  season_class_top_reward
}

enum MarketOrderStatus {
  pending
  delivering
  approved
  rejected
  cancelled
}

enum LeadStatus {
  new
  contacted
  interested
  visited
  trial
  negotiation
  enrolled
  rejected
  lost
  postponed
}

enum LeadActivityType {
  call
  meeting
  note
  status_change
  visit
}

enum QuestionType {
  standard
  open
}

enum Difficulty {
  easy
  medium
  hard
}

enum TestBindingStatus {
  draft
  published
  closed
}

enum TestSessionStatus {
  in_progress
  submitted
  expired
}

enum TestResultStatus {
  pending
  partially_graded
  graded
}

enum PerQuestionStatus {
  pending
  graded
}

enum TestSeasonStatus {
  draft
  active
  closed
}

enum MessageRecipientType {
  all
  class
  student
  season
}

enum MessageDeliveryStatusEnum {
  pending
  sent
  failed
  cancelled
}

enum MessageQueueStatus {
  pending
  processing
  completed
  failed
  cancelled
}

enum MessageQueueFileType {
  photo
  document
}

enum HolidayType {
  single
  range
  recurring
}

enum PremiumStatus {
  active
  expired
  revoked
}

enum PremiumSource {
  purchase
  admin_grant
}

enum ScheduleDay {
  dushanba
  seshanba
  chorshanba
  payshanba
  juma
  shanba
}

// Moliyaviy holat — StudentFinanceStatus DAVR jadvalining qiymati.
// Model nomi bilan to'qnashmasligi uchun `Enum` qo'shimchasi
// (MessageDeliveryStatus / MessageDeliveryStatusEnum uslubi).
enum StudentFinanceStatusEnum {
  active // Faol — hisob-faktura shakllanadi
  frozen // Muzlatilgan — o'qimaydi, majburiyat yo'q
  expelled // Chetlatilgan — o'qishdan chiqarilgan, majburiyat yo'q
}

enum InvoiceStatus {
  unpaid // To'lanmagan (paidAmount = 0)
  partial // Qisman to'langan (0 < paidAmount < amount)
  paid // To'langan (paidAmount >= amount)
  cancelled // Bekor qilingan — yagona "o'chirish" yo'li, sabab va aktyor bilan
}

// Majburiyatni kim shakllantirdi — auditda "qarz qayerdan paydo bo'ldi?".
enum InvoiceSource {
  cron // avtomatik oylik pass
  manual // admin `POST /invoices/generate` orqali
}

enum PaymentMethod {
  cash
  card
  transfer
  other
}

// ─────────────────────────────────────────────
// FOYDALANUVCHI VA ROLLAR
// ─────────────────────────────────────────────

model User {
  id            String    @id @db.Char(24)
  username      String    @unique
  password      String
  plainPassword String?   @map("plain_password")
  firstName     String    @map("first_name")
  lastName      String?   @map("last_name")
  telegramIds   String[]  @map("telegram_ids")
  role          String // Role.value ga ishora (FK emas, service validatsiya)
  // Bo'lim darajasidagi ruxsat kalitlari (utils/permissions.js). Owner uchun ishlatilmaydi — u doim hammaga ega.
  permissions   String[]  @default([]) @map("permissions")
  isActive      Boolean   @default(true) @map("is_active")
  gender        Gender?
  coinBalance   Int       @default(0) @map("coin_balance")
  penaltyPoints Int       @default(0) @map("penalty_points")
  isArchived    Boolean   @default(false) @map("is_archived")
  archivedAt    DateTime? @map("archived_at")
  // { coinBalance, penaltyPoints } — arxivlashdan oldingi zaxira
  archiveSnapshot Json?   @map("archive_snapshot")
  workStartTime String?   @map("work_start_time")
  workEndTime   String?   @map("work_end_time")
  workDays      Int[]     @map("work_days")
  // Map<hafta_kuni, { startTime, endTime }>
  weeklySchedule Json     @default("{}") @map("weekly_schedule")
  premiumIsActive  Boolean   @default(false) @map("premium_is_active")
  premiumExpiresAt DateTime? @map("premium_expires_at")
  profilePicture String?   @map("profile_picture") @db.Char(24)
  emojiBadgeId  String?   @map("emoji_badge_id") // soft ref EmojiConfig (FK emas)
  displayName   String?   @map("display_name")
  nameColor     String?   @map("name_color")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  profileImage Image?      @relation("UserProfileImage", fields: [profilePicture], references: [id])
  classes      UserClass[]

  @@index([role, isActive])
  @@index([role, isArchived])
  @@index([isArchived])
  @@index([premiumIsActive])
  @@map("users")
}

// User ↔ Class M2M junction
model UserClass {
  userId  String @map("user_id") @db.Char(24)
  classId String @map("class_id") @db.Char(24)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([userId, classId])
  @@index([classId])
  @@map("user_classes")
}

model Role {
  id       String  @id @db.Char(24)
  name     String  @unique
  value    String  @unique
  isSystem Boolean @default(false) @map("is_system")

  // Shu rol bilan yangi foydalanuvchi yaratilganda unga beriladigan boshlang'ich
  // ruxsat kalitlari (utils/permissions.js). Mavjud foydalanuvchilarga ta'sir qilmaydi.
  permissions String[] @default([]) @map("permissions")

  workStartTime  String?  @map("work_start_time")
  workEndTime    String?  @map("work_end_time")
  workDays       Int[]    @default([1, 2, 3, 4, 5]) @map("work_days")
  weeklySchedule Json     @default("{}") @map("weekly_schedule")
  createdBy      String   @map("created_by") @db.Char(24)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

// ─────────────────────────────────────────────
// AKADEMIK STRUKTURA
// ─────────────────────────────────────────────

model Class {
  id        String   @id @db.Char(24)
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            UserClass[]
  testBindings     TestBindingClass[]
  weeklyStats      WeeklyStatsClass[]

  @@map("classes")
}

model Subject {
  id          String   @id @db.Char(24)
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by") @db.Char(24)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  topics Topic[]

  @@map("subjects")
}

model Topic {
  id          String   @id @db.Char(24)
  subjectId   String   @map("subject_id") @db.Char(24)
  order       Int
  name        String
  description String?
  createdBy   String   @map("created_by") @db.Char(24)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, order])
  @@index([subjectId])
  @@map("topics")
}

model Schedule {
  id        String      @id @db.Char(24)
  classId   String      @map("class_id") @db.Char(24)
  day       ScheduleDay
  createdBy String      @map("created_by") @db.Char(24)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  lessons ScheduleLesson[]

  @@unique([classId, day])
  @@map("schedules")
}

// schedule.subjects[] → alohida jadval (teacher bo'yicha filter/populate qilinadi)
model ScheduleLesson {
  id         String  @id @db.Char(24)
  scheduleId String  @map("schedule_id") @db.Char(24)
  subjectId  String  @map("subject_id") @db.Char(24)
  teacherId  String  @map("teacher_id") @db.Char(24)
  order      Int
  startTime  String? @map("start_time")
  endTime    String? @map("end_time")
  position   Int // massiv tartibi

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([teacherId])
  @@map("schedule_lessons")
}

model ScheduleSettings {
  id        String   @id @default("singleton") @db.VarChar(24)
  // periods[] — { order, startTime, endTime }
  periods   Json     @default("[]")
  updatedBy String?  @map("updated_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("schedule_settings")
}

model TeacherAssignment {
  id        String   @id @db.Char(24)
  seasonId  String   @map("season_id") @db.Char(24)
  classId   String   @map("class_id") @db.Char(24)
  subjectId String   @map("subject_id") @db.Char(24)
  teacherId String   @map("teacher_id") @db.Char(24)
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String?  @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([seasonId, classId, subjectId, teacherId])
  @@index([teacherId, seasonId])
  @@index([seasonId, classId, subjectId])
  @@map("teacher_assignments")
}

model ClassSubjectProgress {
  id                 String   @id @db.Char(24)
  classId            String   @map("class_id") @db.Char(24)
  subjectId          String   @map("subject_id") @db.Char(24)
  currentTopicNumber Int      @default(1) @map("current_topic_number")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([classId, subjectId])
  @@map("class_subject_progress")
}

// ─────────────────────────────────────────────
// DAVOMAT (XODIMLAR + O'QUVCHILAR)
// ─────────────────────────────────────────────

model Attendance {
  id               String           @id @db.Char(24)
  userId           String           @map("user_id") @db.Char(24)
  date             DateTime
  checkIn          DateTime?        @map("check_in")
  checkOut         DateTime?        @map("check_out")
  status           AttendanceStatus @default(present)
  isLate           Boolean          @default(false) @map("is_late")
  lateMinutes      Int              @default(0) @map("late_minutes")
  isEarlyOut       Boolean          @default(false) @map("is_early_out")
  earlyOutMinutes  Int              @default(0) @map("early_out_minutes")
  // { lat, lng, accuracy }
  checkInLocation  Json?            @map("check_in_location")
  checkOutLocation Json?            @map("check_out_location")
  locationWarning  Boolean          @default(false) @map("location_warning")
  outOfOffice      Boolean          @default(false) @map("out_of_office")
  penaltyApplied   Boolean          @default(false) @map("penalty_applied")
  penaltyRef       String?          @map("penalty_ref") @db.Char(24)
  excuseReason     String?          @map("excuse_reason")
  absenceReason    String?          @map("absence_reason") @db.Char(24)
  autoMarked       Boolean          @default(false) @map("auto_marked")
  createdBy        String?          @map("created_by") @db.Char(24)
  lastModifiedBy   String?          @map("last_modified_by") @db.Char(24)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@index([date, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("attendances")
}

model AttendanceSettings {
  id                         String   @id @default("singleton") @db.VarChar(24)
  // { lat, lng }
  officeLocation             Json?    @map("office_location")
  officeRadius               Int      @default(100) @map("office_radius")
  lateArrivalPenaltyPoints   Int      @default(1) @map("late_arrival_penalty_points")
  lateArrivalGraceMinutes    Int      @default(10) @map("late_arrival_grace_minutes")
  earlyDeparturePenaltyPoints Int     @default(1) @map("early_departure_penalty_points")
  earlyDepartureGraceMinutes Int      @default(10) @map("early_departure_grace_minutes")
  absentPenaltyPoints        Int      @default(2) @map("absent_penalty_points")
  penaltyPaused              Boolean  @default(false) @map("penalty_paused")
  pausedRoles                String[] @map("paused_roles")
  pausedUsers                String[] @map("paused_users")
  updatedBy                  String?  @map("updated_by") @db.Char(24)
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("attendance_settings")
}

model AbsenceReason {
  id           String   @id @db.Char(24)
  title        String
  description  String   @default("")
  roles        String[]
  appliesToAll Boolean  @default(false) @map("applies_to_all")
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    String?  @map("created_by") @db.Char(24)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([appliesToAll, isActive])
  @@map("absence_reasons")
}

model StudentAttendance {
  id             String           @id @db.Char(24)
  studentId      String           @map("student_id") @db.Char(24)
  classId        String           @map("class_id") @db.Char(24)
  date           DateTime
  status         AttendanceStatus @default(absent)
  markedAt       DateTime?        @map("marked_at")
  excuseReason   String?          @map("excuse_reason")
  absenceReason  String?          @map("absence_reason") @db.Char(24)
  autoMarked     Boolean          @default(false) @map("auto_marked")
  createdBy      String?          @map("created_by") @db.Char(24)
  lastModifiedBy String?          @map("last_modified_by") @db.Char(24)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([studentId, date])
  @@index([classId, date])
  @@index([date, status])
  @@index([studentId, createdAt(sort: Desc)])
  @@map("student_attendances")
}

model ExcuseRequest {
  id              String            @id @db.Char(24)
  userId          String            @map("user_id") @db.Char(24)
  date            DateTime
  absenceReason   String?           @map("absence_reason") @db.Char(24)
  reason          String?
  type            ExcuseRequestType
  status          ReviewStatus      @default(pending)
  reviewedBy      String?           @map("reviewed_by") @db.Char(24)
  reviewedAt      DateTime?         @map("reviewed_at")
  rejectionReason String?           @map("rejection_reason")
  // attachments[] — { key, url, type, originalName, sizeBytes }
  attachments     Json              @default("[]")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([userId, date])
  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("excuse_requests")
}

// ─────────────────────────────────────────────
// BAHOLASH VA VAZIFALAR
// ─────────────────────────────────────────────

model Grade {
  id          String   @id @db.Char(24)
  studentId   String   @map("student_id") @db.Char(24)
  subjectId   String   @map("subject_id") @db.Char(24)
  classId     String   @map("class_id") @db.Char(24)
  teacherId   String   @map("teacher_id") @db.Char(24)
  grade       Int
  comment     String?
  date        DateTime
  lessonOrder Int      @default(1) @map("lesson_order")
  isEdited    Boolean  @default(false) @map("is_edited")
  // editHistory[] — { previousGrade, editedAt, editedBy } (faqat audit)
  editHistory Json     @default("[]") @map("edit_history")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([studentId, subjectId, date, lessonOrder])
  @@index([classId, date])
  @@index([teacherId, date])
  @@map("grades")
}

model GradePenaltySettings {
  id                      String   @id @default("singleton") @db.VarChar(24)
  isEnabled               Boolean  @default(true) @map("is_enabled")
  penaltyPoints           Int      @default(1) @map("penalty_points")
  missingThresholdPercent Int      @default(40) @map("missing_threshold_percent")
  exemptTeachers          String[] @map("exempt_teachers")
  updatedBy               String?  @map("updated_by") @db.Char(24)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("grade_penalty_settings")
}

model Task {
  id                    String     @id @db.Char(24)
  title                 String
  description           String
  assignee              String     @db.Char(24)
  createdBy             String     @map("created_by") @db.Char(24)
  status                TaskStatus @default(pending)
  dueDate               DateTime   @map("due_date")
  penaltyPoints         Int        @default(1) @map("penalty_points")
  // attachments[] / completionAttachments[] — { key, url, type, ... }
  attachments           Json       @default("[]")
  completionNote        String?    @map("completion_note")
  completionAttachments Json       @default("[]") @map("completion_attachments")
  penaltyRef            String?    @map("penalty_ref") @db.Char(24)
  autopenalized         Boolean    @default(false)
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  statusHistory   TaskStatusHistory[]
  deadlineHistory TaskDeadlineHistory[]

  @@index([assignee, status])
  @@index([assignee, createdAt(sort: Desc)])
  @@index([createdBy, createdAt(sort: Desc)])
  @@index([status, dueDate])
  @@index([dueDate, autopenalized, status])
  @@map("tasks")
}

model TaskStatusHistory {
  id        String     @id @db.Char(24)
  taskId    String     @map("task_id") @db.Char(24)
  status    TaskStatus
  reason    String
  changedBy String?    @map("changed_by") @db.Char(24)
  changedAt DateTime   @default(now()) @map("changed_at")
  position  Int

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_status_history")
}

model TaskDeadlineHistory {
  id            String   @id @db.Char(24)
  taskId        String   @map("task_id") @db.Char(24)
  oldDueDate    DateTime @map("old_due_date")
  newDueDate    DateTime @map("new_due_date")
  reason        String
  changedBy     String   @map("changed_by") @db.Char(24)
  changedAt     DateTime @default(now()) @map("changed_at")
  withPenalty   Boolean  @default(false) @map("with_penalty")
  penaltyPoints Int      @default(0) @map("penalty_points")
  position      Int

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_deadline_history")
}

// ─────────────────────────────────────────────
// JARIMALAR (PENALTY)
// ─────────────────────────────────────────────

model Penalty {
  id              String       @id @db.Char(24)
  userId          String       @map("user_id") @db.Char(24)
  givenBy         String       @map("given_by") @db.Char(24)
  category        String?      @db.Char(24)
  type            PenaltyType  @default(penalty)
  title           String?
  description     String?
  points          Int
  status          ReviewStatus @default(pending)
  reviewedBy      String?      @map("reviewed_by") @db.Char(24)
  reviewedAt      DateTime?    @map("reviewed_at")
  rejectionReason String?      @map("rejection_reason")
  // attachments[] — { key, url, type, originalName, sizeBytes }
  attachments     Json         @default("[]")
  isCustom        Boolean      @default(false) @map("is_custom")
  fineAmount      Int          @default(0) @map("fine_amount")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([givenBy])
  @@index([type, status, createdAt(sort: Desc)])
  @@map("penalties")
}

model PenaltyCategory {
  id          String   @id @db.Char(24)
  title       String
  description String?
  points      Int
  targetRole  String   @map("target_role")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by") @db.Char(24)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([targetRole, isActive])
  @@map("penalty_categories")
}

model PenaltyNotificationQueue {
  id           String      @id @db.Char(24)
  penaltyId    String      @map("penalty_id") @db.Char(24)
  telegramId   String      @map("telegram_id")
  userId       String?     @map("user_id") @db.Char(24)
  messageText  String      @map("message_text")
  // attachments[] — { url, type, originalName }
  attachments  Json        @default("[]")
  status       QueueStatus @default(pending)
  priority     Int         @default(0)
  attempts     Int         @default(0)
  maxAttempts  Int         @default(3) @map("max_attempts")
  errorMessage String?     @map("error_message")
  processedAt  DateTime?   @map("processed_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([status, priority(sort: Desc), createdAt])
  @@index([penaltyId])
  @@map("penalty_notification_queue")
}

model PenaltySettings {
  id                            String   @id @default("singleton") @db.VarChar(24)
  // Map<role, amount>
  fineAmounts                   Json     @default("{}") @map("fine_amounts")
  studentFineAmount             Int      @default(2100000) @map("student_fine_amount")
  teacherFineAmount             Int      @default(2100000) @map("teacher_fine_amount")
  premiumReductionDiscountPercent Int    @default(0) @map("premium_reduction_discount_percent")
  updatedBy                     String?  @map("updated_by") @db.Char(24)
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

