// Study-Track — PLATFORMA schema'si (filiallardan YUQORIDA turadigan qatlam).
//
// Bitta PostgreSQL baza ichida ikki xil schema bor:
//
//   platform        ← SHU FAYL. Filiallar reyestri, login yo'naltirgichi va
//                     barcha filiallarga UMUMIY kataloglar.
//   public / br_*   ← prisma/schema.prisma. Har filialning o'z ma'lumoti.
//
// NIMA UCHUN IKKI SCHEMA, IKKI CLIENT:
// Filial schema'lari DINAMIK (yangi filial = yangi schema), shuning uchun
// Prisma'ning `multiSchema` xususiyati mos kelmaydi — u schema nomlarini
// kompilyatsiya vaqtida talab qiladi. Buning o'rniga har filial uchun
// `?schema=` bilan alohida PrismaClient ochiladi (config/branchRegistry.js),
// platforma esa doimiy `?schema=platform` bilan (config/platformPrisma.js).
//
// ⚠️ DECIMAL: bu client o'z `runtime/library.js` nusxasini olib yuradi, ya'ni
// `Prisma.Decimal` filial client'inikidan BOSHQA klass. Shuning uchun ikki
// client orasida Decimal uzatishda helpers/money.helpers.js dagi `toDecimal`
// normalizatori ishlatiladi, platformaga yozishda esa summa STRING sifatida
// beriladi (`formatAmount()`).

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/platform"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

// ─────────────────────────────────────────────
// FILIALLAR
// ─────────────────────────────────────────────

// Filial ochish IKKI QADAM: reyestr qatori darhol yoziladi, schema va
// migratsiyalar esa fonda qo'llanadi. Shuning uchun holat maydoni kerak —
// aks holda yarim ochilgan filialga login qilib bo'lardi.
enum BranchStatus {
  provisioning // schema yaratilmoqda / migratsiya qo'llanmoqda
  ready // ishlashga tayyor
  failed // provisioning xato bilan tugadi (provisionError'ga qarang)
}

model Branch {
  id String @id @db.Char(24)

  // Latin, kichik harf, faqat [a-z0-9_]. Schema nomi shundan hosil qilinadi
  // (`br_<code>`), shuning uchun keyin O'ZGARTIRILMAYDI.
  code String @unique
  name String // "Chilonzor filiali"

  // Schema nomi ALOHIDA saqlanadi va `code` dan hosila EMAS: mavjud baza
  // "Bosh filial" bo'lib qolishi kerak, uning schema'si esa `public`.
  // Qayta nomlash — migratsiya emas, ma'lumot yo'qotish xavfi.
  schemaName String @unique @map("schema_name")

  shortName String @default("") @map("short_name")
  address   String @default("")
  phone     String @default("")

  status         BranchStatus @default(provisioning)
  provisionError String?      @map("provision_error")

  // Tokenida `branchId` bo'lmagan ESKI sessiyalar shu filialga tushadi.
  // Reyestrda bittadan ortiq default bo'lishi mumkin emas (service tekshiradi).
  isDefault Boolean @default(false) @map("is_default")

  isActive   Boolean   @default(true) @map("is_active")
  // Filial HECH QACHON o'chirilmaydi — ortida moliyaviy tarix bor
  // (PaymentAccount uslubi). Arxivlangan filialga login qilib bo'lmaydi,
  // lekin yig'ma hisobotda ko'rinadi.
  isArchived Boolean   @default(false) @map("is_archived")
  archivedAt DateTime? @map("archived_at")
  sortOrder  Int       @default(0) @map("sort_order")

  createdBy String?  @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users         UserDirectory[]
  telegramLinks TelegramDirectory[]
  staffAccess   UserBranchAccess[]
  sessions      UserSession[]

  @@index([isArchived, isActive, sortOrder])
  @@map("branches")
}

// ─────────────────────────────────────────────
// LOGIN YO'NALTIRGICHI
// ─────────────────────────────────────────────

// "Bu username qaysi filialda?" — login uchun YAGONA global indeks.
//
// NIMA UCHUN `User` ni butunlay platformaga ko'chirmadik: filial schema'sida
// `User` ga 94 ta joyda `classes` relation'i bilan murojaat qilinadi
// (`where: { classes: { some } }`, `include: { classes }`), ustiga
// `UserClass` va `Image` FK'lari bor. Ularning hammasi cross-schema join'ga
// aylanardi. Shuning uchun platformada faqat YUPQA yo'naltirgich turadi,
// `User` modeli esa umuman o'zgarmaydi.
//
// `id` — AYNAN filial schema'sidagi `User.id`. Shu sababli login bitta
// so'rovda ham filialni, ham foydalanuvchi id'sini beradi.
model UserDirectory {
  id       String @id @db.Char(24)
  username String @unique

  branchId String @map("branch_id") @db.Char(24)

  // Denormalizatsiya: qidiruv va "qaysi filialda nechta o'qituvchi bor"
  // savoliga filial bazasiga bormasdan javob berish uchun.
  role      String
  firstName String @default("") @map("first_name")
  lastName  String @default("") @map("last_name")

  isActive   Boolean @default(true) @map("is_active")
  isArchived Boolean @default(false) @map("is_archived")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // Qaysi filiallarda ishlay oladi (uy filiali ham shu ro'yxatda)
  branchAccess UserBranchAccess[]

  @@index([branchId, role])
  @@index([branchId, isArchived])
  @@map("user_directory")
}

// Telegram → filial. Busiz bot har xabarda BARCHA filial schema'larini
// skanerlashiga to'g'ri kelardi.
model TelegramDirectory {
  telegramId String @id @map("telegram_id")

  branchId  String @map("branch_id") @db.Char(24)
  studentId String @map("student_id") @db.Char(24)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("telegram_directory")
}

// ─────────────────────────────────────────────
// ROLLAR (barcha filiallarga UMUMIY)
// ─────────────────────────────────────────────
// `User.role` — filial schema'sidagi oddiy String (FK EMAS, schema izohida
// shunday yozilgan). Aynan shu sababli rollarni platformaga ko'chirish
// birorta bog'lanishni buzmaydi.

model Role {
  id       String  @id @db.Char(24)
  name     String  @unique
  value    String  @unique
  isSystem Boolean @default(false) @map("is_system")

  // Shu rol bilan yangi foydalanuvchi yaratilganda unga beriladigan boshlang'ich
  // ruxsat kalitlari (utils/permissions.js). Mavjud foydalanuvchilarga ta'sir qilmaydi.
  permissions String[] @default([]) @map("permissions")

  workStartTime  String?  @map("work_start_time")
  workEndTime    String?  @map("work_end_time")
  workDays       Int[]    @default([1, 2, 3, 4, 5]) @map("work_days")
  weeklySchedule Json     @default("{}") @map("weekly_schedule")
  createdBy      String   @map("created_by") @db.Char(24)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

// ─────────────────────────────────────────────
// TARIFLAR VA CHEGIRMALAR KATALOGI (UMUMIY)
// ─────────────────────────────────────────────
// Katalog umumiy, BIRIKTIRISH esa filialda: `StudentTariff.tariffId` va
// `StudentDiscount.discountId` allaqachon soft ref (FK yo'q) — filial
// schema'sidagi izohlarda shunday yozilgan. Hisob-fakturaga narx SNAPSHOT
// bo'lib muhrlanadi, ya'ni katalog ko'chgani bilan o'tgan fakt o'zgarmaydi.

enum DiscountType {
  percent // 0..100
  fixed // qat'iy summa (so'm)
}

// YO'NALISH — tarif ustidagi daraja: "Maktab", "Bog'cha", "Yotoqxona",
// "O'quv markazi".
//
// NIMA UCHUN KERAK: bitta yo'nalishda bir NECHTA narx darajasi bo'ladi
// ("Maktab / Birinchi", "Maktab / Ikkinchi", "Maktab grand"). Rahbar
// hisobotni YO'NALISH kesimida ko'radi, buxgalter esa tarif kesimida.
// Ikkalasini bitta ro'yxatga tiqib qo'ysak, biri ikkinchisini ko'rsata
// olmasdi.
//
// ⚠️ PLATFORMADA yashaydi — `Tariff` bilan bir joyda. Narx katalogi
// barcha filiallarga umumiy, ya'ni uning guruhlagichi ham umumiy
// bo'lishi kerak.
//
// ⚠️ Yo'nalish IXTIYORIY: tarifga biriktirilmagan bo'lsa, hisobotda
// tarifning o'z nomi bilan turadi. Majburiy qilinsa, mavjud tariflar
// birdaniga "noto'g'ri" bo'lib qolardi.
model TariffDirection {
  id   String @id @db.Char(24)
  name String @unique

  description String @default("")
  // Hisobotdagi tartib — rahbar ko'radigan ketma-ketlik biznes qarori
  sortOrder   Int    @default(0) @map("sort_order")

  isActive   Boolean   @default(true) @map("is_active")
  // O'CHIRILMAYDI — arxivlanadi: o'tgan hisob-fakturalar unga ishora qiladi
  isArchived Boolean   @default(false) @map("is_archived")
  archivedAt DateTime? @map("archived_at")

  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tariffs Tariff[]

  @@index([isArchived, isActive, sortOrder])
  @@map("tariff_directions")
}

model Tariff {
  id          String    @id @db.Char(24)
  name        String    @unique
  // Yo'nalish — ixtiyoriy. `Restrict`: yo'nalish o'chirilmaydi, arxivlanadi
  directionId String?   @map("direction_id") @db.Char(24)
  description String    @default("")
  currency    String    @default("UZS") @db.Char(3)
  isActive    Boolean   @default(true) @map("is_active")
  isArchived  Boolean   @default(false) @map("is_archived")
  archivedAt  DateTime? @map("archived_at")
  createdBy   String    @map("created_by") @db.Char(24)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  versions  TariffVersion[]
  direction TariffDirection? @relation(fields: [directionId], references: [id], onDelete: Restrict)

  // Katalogda narx maydoni YO'Q — versiyalashning butun mohiyati shu.
  @@index([isArchived, isActive, name])
  @@index([directionId])
  @@map("tariffs")
}

model TariffVersion {
  id            String   @id @db.Char(24)
  tariffId      String   @map("tariff_id") @db.Char(24)
  startMonth    Int      @map("start_month")
  endMonth      Int?     @map("end_month")
  monthlyAmount Decimal  @map("monthly_amount") @db.Decimal(14, 2)
  createdBy     String   @map("created_by") @db.Char(24)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tariff Tariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  @@unique([tariffId, startMonth])
  @@index([tariffId, startMonth(sort: Desc)])
  @@map("tariff_versions")
}

model Discount {
  id          String       @id @db.Char(24)
  name        String       @unique
  description String       @default("")
  type        DiscountType
  value       Decimal      @db.Decimal(14, 2)
  isExclusive Boolean      @default(false) @map("is_exclusive")
  isActive    Boolean      @default(true) @map("is_active")
  isArchived  Boolean      @default(false) @map("is_archived")
  archivedAt  DateTime?    @map("archived_at")
  createdBy   String       @map("created_by") @db.Char(24)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([isArchived, isActive, name])
  @@map("discounts")
}

// ─────────────────────────────────────────────
// O'ZGARISHLAR TARIXI (dasturiy ta'minot darajasida — UMUMIY)
// ─────────────────────────────────────────────

enum ChangelogPanel {
  admin
  teacher
  student
  server
  bot
}

enum ChangelogBump {
  major
  minor
  patch
}

model Changelog {
  id String @id @db.Char(24)

  panel ChangelogPanel
  date  DateTime
  seq   Int            @default(1)

  version String
  major   Int
  minor   Int
  patch   Int
  bump    ChangelogBump @default(patch)

  title String   @default("")
  items String[] @default([])
  notes String   @default("")

  sourceFile String?  @map("source_file")
  createdBy  String?  @map("created_by") @db.Char(24)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([date, panel, seq])
  @@unique([panel, version])
  @@index([panel, major(sort: Desc), minor(sort: Desc), patch(sort: Desc)])
  @@index([date(sort: Desc)])
  @@map("changelogs")
}

enum ChangelogNotificationKind {
  daily
  weekly
  manual
}

enum ChangelogNotificationStatus {
  sent
  failed
}

model ChangelogSettings {
  id String @id @default("singleton") @db.VarChar(24)

  dailyEnabled Boolean @default(false) @map("daily_enabled")
  sendTime     String  @default("09:00") @map("send_time")

  weeklyEnabled Boolean @default(false) @map("weekly_enabled")

  recipients Json @default("[]")

  lastDailySentDate DateTime? @map("last_daily_sent_date")
  lastDailySentAt   DateTime? @map("last_daily_sent_at")
  lastWeeklySentAt  DateTime? @map("last_weekly_sent_at")

  updatedBy String?  @map("updated_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("changelog_settings")
}

model ChangelogNotification {
  id String @id @db.Char(24)

  kind   ChangelogNotificationKind   @default(daily)
  status ChangelogNotificationStatus

  coverageDate DateTime? @map("coverage_date")
  coverageFrom DateTime? @map("coverage_from")
  coverageTo   DateTime? @map("coverage_to")

  chatId String @map("chat_id")
  label  String @default("")

  entryCount   Int     @default(0) @map("entry_count")
  messageCount Int     @default(0) @map("message_count")
  errorMessage String? @map("error_message")

  sentBy    String?  @map("sent_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([kind, coverageDate])
  @@map("changelog_notifications")
}

// XODIM QAYSI FILIALLARDA ISHLAY OLADI.
//
// `UserDirectory` — login yo'naltirgichi: "bu username qaysi filialga
// tegishli" (UY filiali). Bu jadval esa undan kengroq savolga javob beradi:
// "bu odam yana qaysi filiallarga kira oladi".
//
// NIMA UCHUN ALOHIDA JADVAL: ruxsatlar HAR FILIALDA BOSHQA bo'lishi kerak
// (Chilonzorda kassir, Yunusobodda o'qituvchi). Ruxsatlar esa filial
// schema'sidagi `User.permissions` da yotadi — ya'ni odamning har filialda
// o'z qatori bor va u qator o'z ruxsatini olib yuradi. Bu jadval faqat
// "kirishga ruxsat berilganmi" degan reyestr.
//
// OWNER BU YERDA YO'Q: u har filialda avtomatik mavjud (filial ochilganda
// aynan o'sha `id` bilan seed qilinadi), shuning uchun unga biriktirish
// yozuvi kerak emas — `auth.service.js` uni rol bo'yicha o'tkazadi.
model UserBranchAccess {
  userId   String @map("user_id") @db.Char(24)
  branchId String @map("branch_id") @db.Char(24)

  // Shu FILIALDAGI roli — uy filialidagidan farq qilishi mumkin.
  // Denormalizatsiya: ro'yxatni chizish uchun N ta filial bazasiga
  // bormaslik kerak.
  role String

  // Uy filiali — `UserDirectory.branchId` bilan bir xil qator.
  // Login har doim shu yerga tushadi va uni yechib bo'lmaydi.
  isHome Boolean @default(false) @map("is_home")

  createdBy String?  @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   UserDirectory @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([branchId, role])
  @@map("user_branch_access")
}

// ═════════════════════════════════════════════════════════════════════
// XAVFSIZLIK — SEANS, KIRISH URINISHI, OGOHLANTIRISH
// ═════════════════════════════════════════════════════════════════════
//
// ⚠️ NIMA UCHUN PLATFORMADA, FILIALDA EMAS — uch sabab:
//
//   1. MAVJUD BO'LMAGAN LOGIN bilan urinishda filial KONTEKSTI YO'Q.
//      `auth.service.js` avval username bo'yicha filialni topadi; nom
//      umuman mavjud bo'lmasa, `config/prisma.js` Proxy'si "Filial
//      konteksti yo'q" xatosini tashlaydi. Filial jadvaliga yozmoqchi
//      bo'lsak, aynan eng qimmatli hodisa — noma'lum nom bilan
//      brute-force — YOZILMAY qolardi.
//
//   2. XODIM BIR NECHTA FILIALDA ishlaydi. "Bitta hisobda ikkita seans"
//      savoli filial ichida berilsa, Chilonzor va Yunusobodda ochilgan
//      ikki seans bir-birini KO'RMASDI — qoida esa aynan shuni topadi.
//
//   3. Odam — global tushuncha (`UserDirectory`), filial esa uning ish
//      joyi. Xavfsizlik ODAM haqida.
//
// ⚠️ KO'RISH HUQUQI BARIBIR FILIAL BO'YICHA. `User.permissions` har
// filialda alohida, shuning uchun so'rovlarda `branchId` filtri bor
// (`securityDashboard.service.js`): Chilonzorda `security.view` olgan
// xodim Yunusobodning seanslarini ko'rmaydi. Owner — istisno.
//
// ⚠️ FK YO'Q va bo'lishi ham mumkin emas: `userId` filial schema'sidagi
// `User.id` ga ishora qiladi, u esa boshqa schema'da. `UserDirectory`
// ga FK qo'yish mumkin edi, lekin u login yo'naltirgichi va o'chirilishi
// mumkin — xavfsizlik tarixi esa qolishi kerak.

/**
 * Kanal — qaysi paneldan/ilovadan kelgan.
 * ⚠️ Filial schema'sidagi `ActivityChannel` ning NUSXASI. Ikki alohida
 * Prisma schema bitta enumni bo'lisha olmaydi. Qiymatlar `utils/constants.js`
 * dagi `ACTIVITY_CHANNELS` bilan bir xil bo'lishi shart — u yagona
 * validatsiya nuqtasi.
 */
enum SessionChannel {
  bot
  admin
  teacher
  student
  reception
  worker
}

/**
 * Seans qanday tugadi. `active` — hali ochiq.
 */
enum SessionEndReason {
  active
  logout
  revoked
  expired
  superseded
}

/**
 * KIRISH SEANSI — har muvaffaqiyatli login uchun BITTA qator.
 * ⚠️ TOKEN BILAN BOG'LANGAN: `jti` — JWT ichidagi noyob identifikator.
 * Usiz "bu seansni tugat" tugmasi ishlamasdi, chunki chiqarilgan token
 * hech qayerda ro'yxatga olinmagan bo'lardi.
 * ⚠️ ESKI TOKENLAR `jti` SIZ. Ular ishlashda davom etadi (hech kim
 * tizimdan uchib chiqmaydi), lekin seans ro'yxatida ko'rinmaydi va
 * bekor qilinmaydi — muddati tugagach o'zi yo'qoladi. Bu ataylab:
 * xavfsizlik bo'limini yoqish butun maktabni tizimdan chiqarib
 * yubormasligi kerak.
 * ⚠️ `expiresAt` TOKENNING O'ZIDAN olinadi (`decoded.exp`), qo'lda
 * hisoblanmaydi: `JWT_EXPIRES_IN` o'zgarsa ikkita haqiqat manbai
 * paydo bo'lardi.
 * ⚠️ FILIAL ALMASHTIRISH — YANGI SEANS. `POST /auth/switch-branch` yangi
 * token beradi, eskisi esa `superseded` bilan yopiladi. Aks holda bir
 * odamning bitta brauzerdagi ishi "ikkita bir vaqtdagi seans" bo'lib
 * ko'rinardi va ogohlantirish soxta bo'lardi.
 */
model UserSession {
  id String @id @db.Char(24)

  // Filial schema'sidagi `User.id` (FK EMAS — boshqa schema).
  userId   String @map("user_id") @db.Char(24)
  // Qidiruv va ro'yxat uchun — filial bazasiga bormaslik kerak.
  username String @default("") @db.VarChar(120)
  // Qaysi filialga kirdi.
  branchId String @map("branch_id") @db.Char(24)

  // JWT `jti` — token bilan seansni bog'laydigan yagona ip.
  jti String @unique @db.VarChar(32)

  channel SessionChannel @default(admin)

  ip        String? @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(400)
  // "Chrome · Windows" — ro'yxatda o'qiladigan yorliq.
  device    String? @db.VarChar(120)

  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")

  endedAt   DateTime?        @map("ended_at")
  endReason SessionEndReason @default(active) @map("end_reason")
  // Kim tugatdi (admin bekor qilganda).
  endedBy   String?          @map("ended_by") @db.Char(24)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([branchId, endReason, lastSeenAt(sort: Desc)])
  @@index([endReason, expiresAt])
  @@index([createdAt(sort: Desc)])
  @@map("user_sessions")
}

/**
 * KIRISH URINISHI — muvaffaqiyatli ham, muvaffaqiyatsiz ham.
 * ⚠️ IKKALASI BITTA JADVALDA. "Bu hisobga 14 marta noto'g'ri parol
 * bilan urinildi, 15-chisi o'tdi" degan ketma-ketlik faqat ikkalasi
 * BITTA vaqt o'qida turgandagina ko'rinadi.
 * ⚠️ `branchId` IXTIYORIY: noma'lum login bilan kelgan urinishda hech
 * qanday filial yo'q va uni "taxmin qilish" yolg'on bo'lardi. Bunday
 * qatorlar faqat owner'ga ko'rinadi.
 * ⚠️ PAROL HECH QACHON YOZILMAYDI (hatto noto'g'risi ham).
 */
model LoginAttempt {
  id String @id @db.Char(24)

  username String  @db.VarChar(120)
  userId   String? @map("user_id") @db.Char(24)
  branchId String? @map("branch_id") @db.Char(24)

  success Boolean
  // "ok" | "bad_password" | "unknown_user" | "inactive" | "archived" | "rate_limited"
  reason  String  @default("ok") @db.VarChar(24)

  channel   SessionChannel @default(admin)
  ip        String?        @db.VarChar(45)
  userAgent String?        @map("user_agent") @db.VarChar(400)
  device    String?        @db.VarChar(120)

  createdAt DateTime @default(now()) @map("created_at")
  day       DateTime @map("day") @db.Date

  @@index([day, success])
  @@index([branchId, createdAt(sort: Desc)])
  @@index([username, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([ip, createdAt(sort: Desc)])
  @@map("login_attempts")
}

/**
 * Ogohlantirish turi.
 */
enum SecurityAlertType {
  concurrent_session
  new_device
  new_ip
  brute_force
  rapid_switch
  night_login
  dormant_login
}

/**
 * Jiddiylik — ro'yxat tartibi va rang shu yerdan.
 */
enum SecurityAlertSeverity {
  low
  medium
  high
  critical
}

/**
 * Ogohlantirish holati.
 */
enum SecurityAlertStatus {
  open
  acknowledged
  resolved
}

/**
 * XAVFSIZLIK OGOHLANTIRISHI.
 * ⚠️ TIZIM HECH NARSANI TO'XTATMAYDI — u faqat QAYD ETADI va ko'rsatadi
 * (`financeReconcile.job.js` bilan bir xil doktrina). Ikkinchi seansni
 * avtomatik uzib qo'ysak, direktor telefonidan kirganida kompyuteridagi
 * ishi yo'qolardi; "bu parol tarqalganmi yoki odam ikkita qurilmadami"
 * degan savolga faqat ODAM javob bera oladi. Uzish tugmasi bor, lekin
 * uni odam bosadi (`security.revoke`).
 * ⚠️ BIR HODISAGA BIR OGOHLANTIRISH: `dedupeKey` unikal. Bitta hisobga
 * bir kunda o'n marta kirilsa ham ro'yxatda bitta qator turadi, ichidagi
 * `hitCount` esa o'sadi. Aks holda ekran bitta hodisaning nusxalari
 * bilan to'lib ketardi va IKKINCHI, haqiqiy muammo ko'rinmay qolardi.
 * ⚠️ `dedupeKey` ICHIDA KUN BOR. Xodim "bu direktorning ikkinchi
 * telefoni, tushundim" deb yopgan holat ertasiga yana qalqib chiqmasligi
 * kerak — lekin ertangi hodisa YANGI kalit oladi va yangi qator bo'lib
 * chiqadi. Ya'ni "yopdim" bugun uchun amal qiladi, abadiy emas.
 */
model SecurityAlert {
  id String @id @db.Char(24)

  type     SecurityAlertType
  severity SecurityAlertSeverity @default(medium)
  status   SecurityAlertStatus   @default(open)

  userId   String? @map("user_id") @db.Char(24)
  username String  @default("") @db.VarChar(120)
  branchId String? @map("branch_id") @db.Char(24)

  // Ogohlantirishni keltirib chiqargan seans (bo'lsa).
  sessionId String? @map("session_id") @db.Char(24)

  // "<tur>:<userId>:<kun>" — takrorni to'sadi.
  dedupeKey String @unique @map("dedupe_key") @db.VarChar(140)

  title  String @db.VarChar(160)
  detail String @default("") @db.Text

  // Hodisaning o'sha paytdagi xom tafsiloti (IP lar, qurilmalar, sanoq).
  meta Json?

  hitCount    Int      @default(1) @map("hit_count")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  day         DateTime @map("day") @db.Date

  acknowledgedBy String?   @map("acknowledged_by") @db.Char(24)
  acknowledgedAt DateTime? @map("acknowledged_at")
  resolvedAt     DateTime? @map("resolved_at")
  note           String    @default("") @db.Text

  @@index([status, severity, lastSeenAt(sort: Desc)])
  @@index([branchId, status, lastSeenAt(sort: Desc)])
  @@index([userId, lastSeenAt(sort: Desc)])
  @@index([day, type])
  @@map("security_alerts")
}
