.env
node_modules
logs
package-lock.json
*scripts
uploads
# Migratsiya skriptini git'da saqlaymiz (yuqoridagi *scripts istisnosi)
!src/scripts/
src/scripts/*
!src/scripts/migrate-mongo-to-postgres/
!src/scripts/import-changes/
# Prisma Client (generatsiya artifakti — `prisma generate` qayta yaratadi)
src/generated
!src/scripts/branch-migrate/
!src/scripts/branch-bootstrap/
# ⚠️ package.json dagi `seed:academic` shu faylga ishora qiladi — istisnosiz
# u toza klonga yetib bormay, buyruq "Cannot find module" bilan yiqilardi.
!src/scripts/seedAcademicDemo.js
# ⚠️ Login tashxisi PRODDA ishga tushiriladi — istisnosiz u serverga
# yetib bormasdi va aynan kerak bo'lgan joyda qo'lda ko'chirish talab qilinardi.
!src/scripts/diagnose-login.js
!src/scripts/backfill-user-directory.js
# ⚠️ O'quvchilar soni tashxisi ham PRODDA ishga tushiriladi ("bir ekranda
# 508, boshqasida 524"): u yerdagi ma'lumotsiz savolga javob yo'q.
!src/scripts/diagnose-student-count.js
# ⚠️ Ruxsat grant skripti PRODDA ishga tushiriladi va `package.json` dagi
# `perm:grant` unga ishora qiladi: istisnosiz u toza klonga yetib bormay,
# buyruq "Cannot find module" bilan yiqilardi (`seedAcademicDemo.js` bilan
# AYNI tuzoq). Yangi ruxsat kaliti qo'shilganda uni rollarga va o'sha
# roldagi mavjud xodimlarga yoyadigan yagona yo'l shu skript.
!src/scripts/grant-permission.js
